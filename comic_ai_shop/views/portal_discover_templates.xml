<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bouton « Découvrir de nouvelles BD » sur /my/library -->
    <template id="portal_library_index_discover_link" inherit_id="comic_shop.portal_library_index"
              name="Ma Bibliothèque — découvrir de nouvelles BD">
        <xpath expr="//a[hasclass('o_comic_dashboard_link')]" position="before">
            <a href="/my/library/discover" class="btn btn-outline-primary btn-sm me-2 o_comic_discover_link">
                <i class="fa fa-magic me-1"/>Découvrir de nouvelles BD
            </a>
        </xpath>
    </template>

    <!-- /my/library/discover : profil, suggestions de l'IA, ajout en wishlist -->
    <template id="portal_library_discover" name="Découvrir de nouvelles BD — Ma Bibliothèque">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" t-value="False"/>

            <div class="o_portal_wrap">
                <div class="container mt-4 mb-5 o_comic_discover">

                    <nav aria-label="breadcrumb" class="mb-4">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/my/home">Mon compte</a></li>
                            <li class="breadcrumb-item"><a href="/my/library">Ma Bibliothèque</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Découvrir de nouvelles BD</li>
                        </ol>
                    </nav>

                    <t t-if="flash">
                        <div t-attf-class="alert alert-{{ flash.get('type', 'info') }} alert-dismissible fade show" role="alert">
                            <t t-esc="flash.get('message', '')"/>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"/>
                        </div>
                    </t>

                    <h2 class="mb-1">Découvrir de nouvelles BD</h2>
                    <p class="text-muted mb-4">
                        À partir des séries que vous avez le mieux notées, l'IA vous propose des séries
                        que vous ne connaissez pas encore. Celles déjà dans votre collection ou votre
                        wishlist sont écartées.
                    </p>

                    <!-- Profil de goûts -->
                    <div class="card mb-4">
                        <div class="card-header fw-semibold">
                            <i class="fa fa-star me-1 text-warning"/>Mon profil de goûts
                        </div>
                        <div class="card-body">
                            <t t-if="not candidates">
                                <div class="alert alert-light border mb-0 o_comic_discover_empty">
                                    Votre bibliothèque est vide. Ajoutez vos BD et notez au moins une BD 4★
                                    pour obtenir des suggestions.
                                    <a href="/my/library/add" class="ms-1">Ajouter une BD</a>
                                </div>
                            </t>
                            <t t-else="">
                                <form action="/my/library/discover/suggest" method="post" class="o_comic_discover_profile">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <p class="small text-muted">
                                        Les séries cochées forment votre profil (par défaut : celles dont vous
                                        avez noté un album 4★ ou plus). Cochez ou décochez avant de lancer la recherche.
                                    </p>
                                    <t t-if="not checked_ids">
                                        <div class="alert alert-warning small">
                                            Aucune BD notée 4★ : notez au moins une BD 4★ dans votre bibliothèque,
                                            ou cochez ci-dessous les séries que vous aimez.
                                        </div>
                                    </t>
                                    <div class="row row-cols-1 row-cols-md-2 g-1 mb-3">
                                        <t t-foreach="candidates" t-as="serie">
                                            <div class="col">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="serie_ids"
                                                           t-att-value="serie.id"
                                                           t-att-id="'discover_serie_%s' % serie.id"
                                                           t-att-checked="'checked' if serie.id in checked_ids else None"/>
                                                    <label class="form-check-label" t-att-for="'discover_serie_%s' % serie.id">
                                                        <t t-esc="serie.name"/>
                                                        <small t-if="serie.genre_id" class="text-muted">
                                                            · <t t-esc="serie.genre_id.name"/>
                                                        </small>
                                                    </label>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                    <div class="d-flex flex-wrap align-items-center gap-3">
                                        <button type="submit" class="btn btn-primary"
                                                t-att-disabled="'disabled' if remaining &lt;= 0 else None">
                                            <i class="fa fa-magic me-1"/>Obtenir des suggestions
                                        </button>
                                        <span class="small text-muted o_comic_discover_quota">
                                            <t t-if="remaining &gt; 0">
                                                <t t-esc="remaining"/> recherche(s) restante(s) aujourd'hui
                                                sur <t t-esc="daily_limit"/>.
                                            </t>
                                            <t t-else="">
                                                Limite quotidienne atteinte (<t t-esc="daily_limit"/> recherche(s)
                                                par jour) : revenez demain.
                                            </t>
                                        </span>
                                    </div>
                                </form>
                            </t>
                        </div>
                    </div>

                    <!-- Suggestions -->
                    <t t-if="wizard and wizard.state == 'suggestions'">
                        <h3 id="suggestions" class="h4 mb-3">Suggestions</h3>
                        <t t-if="not lines">
                            <div class="alert alert-light border">
                                Aucune nouvelle série à proposer : toutes les suggestions de l'IA sont déjà
                                connues. Modifiez votre profil et relancez la recherche.
                            </div>
                        </t>
                        <t t-else="">
                            <form action="/my/library/discover/add" method="post" class="o_comic_discover_suggestions">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <ul class="list-group mb-3">
                                    <t t-foreach="lines" t-as="line">
                                        <li class="list-group-item py-3" t-att-id="'suggestion-%s' % line.id">
                                            <div class="d-flex gap-3">
                                                <div class="pt-1">
                                                    <input class="form-check-input" type="checkbox" name="line_ids"
                                                           t-att-value="line.id"
                                                           t-att-id="'discover_line_%s' % line.id"
                                                           t-att-disabled="'disabled' if line.added else None"
                                                           t-att-aria-label="line.name"/>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <label class="fw-semibold mb-0" t-att-for="'discover_line_%s' % line.id">
                                                        <t t-esc="line.name"/>
                                                    </label>
                                                    <span t-if="line.genre" class="badge text-bg-light border ms-1" t-esc="line.genre"/>
                                                    <span t-if="line.serie_id" class="badge text-bg-info ms-1">Au catalogue</span>
                                                    <span t-if="line.added" class="badge text-bg-success ms-1">
                                                        <i class="fa fa-check me-1"/>Dans ma wishlist
                                                    </span>
                                                    <div t-if="line.auteurs" class="small text-muted" t-esc="line.auteurs"/>
                                                    <p t-if="line.raison" class="mb-1 mt-1" t-esc="line.raison"/>
                                                    <div class="small d-flex flex-wrap align-items-center gap-2">
                                                        <t t-if="line.verify_state == 'found'">
                                                            <span class="text-success"><i class="fa fa-check-circle me-1"/><t t-esc="line.verify_info"/></span>
                                                        </t>
                                                        <t t-elif="line.verify_state == 'not_found'">
                                                            <span class="text-danger"><i class="fa fa-exclamation-triangle me-1"/><t t-esc="line.verify_info"/></span>
                                                        </t>
                                                        <t t-elif="line.verify_state == 'error'">
                                                            <span class="text-warning"><i class="fa fa-exclamation-circle me-1"/><t t-esc="line.verify_info"/></span>
                                                        </t>
                                                        <button t-if="not line.added" type="submit"
                                                                formaction="/my/library/discover/verify"
                                                                name="verify_line_id" t-att-value="line.id"
                                                                class="btn btn-link btn-sm p-0 o_comic_discover_verify">
                                                            <i class="fa fa-search me-1"/>Vérifier sur les sources
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </li>
                                    </t>
                                </ul>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-heart me-1"/>Ajouter à ma wishlist
                                </button>
                                <span class="small text-muted ms-2">Le premier tome de chaque série cochée est ajouté.</span>
                            </form>
                        </t>
                    </t>

                </div>
            </div>
        </t>
    </template>

</odoo>
