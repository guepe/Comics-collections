<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_fill_missing_purchase_links" model="ir.cron">
            <field name="name">Comics — Fill in missing purchase links</field>
            <field name="model_id" ref="model_comic_edition"/>
            <field name="state">code</field>
            <field name="code">model._cron_fill_missing_purchase_links()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
        </record>

        <record id="cron_remind_overdue_loans" model="ir.cron">
            <field name="name">Comics — Overdue loan reminders</field>
            <field name="model_id" ref="model_comic_pret"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
