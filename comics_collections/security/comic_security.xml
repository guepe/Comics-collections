<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_comic_collection" model="ir.module.category">
        <field name="name">Bandes Dessinées</field>
        <field name="sequence">100</field>
    </record>

    <!-- Privilege (lien catégorie → groupes, obligatoire en Odoo 19) -->

    <record id="privilege_comic_collection" model="res.groups.privilege">
        <field name="name">Bandes Dessinées</field>
        <field name="category_id" ref="module_category_comic_collection"/>
        <field name="placeholder">Aucun accès</field>
        <field name="sequence">100</field>
    </record>

    <!-- Groupes -->

    <record id="group_comic_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="privilege_id" ref="privilege_comic_collection"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_comic_manager" model="res.groups">
        <field name="name">Gestionnaire</field>
        <field name="privilege_id" ref="privilege_comic_collection"/>
        <field name="implied_ids" eval="[Command.link(ref('group_comic_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- Record rules — catalogue partagé
         Séries, albums (comic.work) et éditions forment un référentiel commun :
         tout utilisateur BD peut les lire, créer et modifier (aucune règle de
         lecture → pas de restriction). La possession reste propre à chaque
         utilisateur via comic.customer.album (bibliothèque personnelle).
         Suppression : un utilisateur ne peut supprimer que ce qu'il a créé ;
         le gestionnaire (règle OR) peut tout supprimer. -->

    <record id="rule_comic_serie_user" model="ir.rule">
        <field name="name">Séries : utilisateur ne supprime que ses propres fiches</field>
        <field name="model_id" ref="model_comic_serie"/>
        <field name="groups" eval="[Command.link(ref('group_comic_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_comic_serie_manager" model="ir.rule">
        <field name="name">Séries : gestionnaire voit tout</field>
        <field name="model_id" ref="model_comic_serie"/>
        <field name="groups" eval="[Command.link(ref('group_comic_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_comic_work_user" model="ir.rule">
        <field name="name">Albums : utilisateur ne supprime que ses propres fiches</field>
        <field name="model_id" ref="model_comic_work"/>
        <field name="groups" eval="[Command.link(ref('group_comic_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_comic_work_manager" model="ir.rule">
        <field name="name">Albums : gestionnaire voit tout</field>
        <field name="model_id" ref="model_comic_work"/>
        <field name="groups" eval="[Command.link(ref('group_comic_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_comic_edition_user" model="ir.rule">
        <field name="name">Éditions : utilisateur ne supprime que ses propres fiches</field>
        <field name="model_id" ref="model_comic_edition"/>
        <field name="groups" eval="[Command.link(ref('group_comic_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_comic_edition_manager" model="ir.rule">
        <field name="name">Éditions : gestionnaire voit tout</field>
        <field name="model_id" ref="model_comic_edition"/>
        <field name="groups" eval="[Command.link(ref('group_comic_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Record rules : comic.pret — les prêts sont privés -->

    <record id="rule_comic_pret_user" model="ir.rule">
        <field name="name">Prêts : utilisateur voit ses propres prêts</field>
        <field name="model_id" ref="model_comic_pret"/>
        <field name="groups" eval="[Command.link(ref('group_comic_user'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_comic_pret_manager" model="ir.rule">
        <field name="name">Prêts : gestionnaire voit tout</field>
        <field name="model_id" ref="model_comic_pret"/>
        <field name="groups" eval="[Command.link(ref('group_comic_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Bibliothèque personnelle : chacun ne voit que ses propres entrées.
         (comic_shop ajoute le portail et le « voit tout » du gestionnaire shop.) -->
    <record id="rule_customer_album_user" model="ir.rule">
        <field name="name">Bibliothèque : utilisateur voit ses propres entrées</field>
        <field name="model_id" ref="model_comic_customer_album"/>
        <field name="groups" eval="[Command.link(ref('group_comic_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    </record>

</odoo>
