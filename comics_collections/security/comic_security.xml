<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_comic_collection" model="ir.module.category">
        <field name="name">Bandes Dessinées</field>
        <field name="sequence">100</field>
    </record>

    <!-- Privilege (lien catégorie → groupes, obligatoire en Odoo 19) -->

    <record id="privilege_comic_collection" model="res.groups.privilege">
        <field name="name">Bandes Dessinées</field>
        <field name="category_id" ref="module_category_comic_collection"/>
        <field name="placeholder">Aucun accès</field>
        <field name="sequence">100</field>
    </record>

    <!-- Groupes -->

    <record id="group_comic_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="privilege_id" ref="privilege_comic_collection"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_comic_manager" model="res.groups">
        <field name="name">Gestionnaire</field>
        <field name="privilege_id" ref="privilege_comic_collection"/>
        <field name="implied_ids" eval="[Command.link(ref('group_comic_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- Record rules : comic.serie
         Utilisateur voit uniquement sa propre collection.
         Gestionnaire (qui implique utilisateur) voit tout grâce à la règle manager (OR). -->

    <record id="rule_comic_serie_user" model="ir.rule">
        <field name="name">Séries : utilisateur voit sa propre collection</field>
        <field name="model_id" ref="model_comic_serie"/>
        <field name="groups" eval="[(4, ref('group_comic_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_comic_serie_manager" model="ir.rule">
        <field name="name">Séries : gestionnaire voit tout</field>
        <field name="model_id" ref="model_comic_serie"/>
        <field name="groups" eval="[(4, ref('group_comic_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Record rules : comic.work -->

    <record id="rule_comic_work_user" model="ir.rule">
        <field name="name">Œuvres : utilisateur voit sa propre collection</field>
        <field name="model_id" ref="model_comic_work"/>
        <field name="groups" eval="[(4, ref('group_comic_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_comic_work_manager" model="ir.rule">
        <field name="name">Œuvres : gestionnaire voit tout</field>
        <field name="model_id" ref="model_comic_work"/>
        <field name="groups" eval="[(4, ref('group_comic_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Record rules : comic.edition -->

    <record id="rule_comic_edition_user" model="ir.rule">
        <field name="name">Éditions : utilisateur voit sa propre collection</field>
        <field name="model_id" ref="model_comic_edition"/>
        <field name="groups" eval="[(4, ref('group_comic_user'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_comic_edition_manager" model="ir.rule">
        <field name="name">Éditions : gestionnaire voit tout</field>
        <field name="model_id" ref="model_comic_edition"/>
        <field name="groups" eval="[(4, ref('group_comic_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
