    <!-- ===== SÉRIES ===== -->

    <record id="serie_asterix" model="comic.serie">
        <field name="name">Astérix</field>
        <field name="type">bd</field>
        <field name="statut">en_cours</field>
        <field name="genre_id" ref="genre_humour"/>
        <field name="editeur_id" ref="editeur_albert_rene"/>
        <field name="synopsis"><![CDATA[
            <p>La série culte de René Goscinny et Albert Uderzo. Un village gaulois résiste
            encore et toujours à l'envahisseur romain, grâce à la potion magique du druide Panoramix.</p>
        ]]></field>
    </record>

    <record id="serie_blacksad" model="comic.serie">
        <field name="name">Blacksad</field>
        <field name="type">bd</field>
        <field name="statut">en_cours</field>
        <field name="genre_id" ref="genre_policier"/>
        <field name="editeur_id" ref="editeur_dargaud"/>
        <field name="synopsis"><![CDATA[
            <p>John Blacksad est un détective privé dans une ville américaine des années 50,
            peuplée d'animaux anthropomorphes. Un polar noir envoûtant aux aquarelles somptueuses.</p>
        ]]></field>
    </record>

    <record id="serie_largo_winch" model="comic.serie">
        <field name="name">Largo Winch</field>
        <field name="type">bd</field>
        <field name="statut">en_cours</field>
        <field name="genre_id" ref="genre_aventure"/>
        <field name="editeur_id" ref="editeur_dupuis"/>
        <field name="synopsis"><![CDATA[
            <p>Largo Winch hérite à la mort de son père adoptif d'un empire financier mondial.
            Aventures internationales, complots et action au cœur du monde des affaires.</p>
        ]]></field>
    </record>

