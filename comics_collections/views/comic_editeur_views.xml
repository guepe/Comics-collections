<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_comic_editeur_list" model="ir.ui.view">
        <field name="name">comic.editeur.list</field>
        <field name="model">comic.editeur</field>
        <field name="arch" type="xml">
            <list string="Éditeurs">
                <field name="name"/>
                <field name="pays_id"/>
                <field name="site_web" widget="url"/>
                <field name="comic_serie_count" string="Séries" optional="show"/>
                <field name="comic_work_count" string="Albums" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_comic_editeur_form" model="ir.ui.view">
        <field name="name">comic.editeur.form</field>
        <field name="model">comic.editeur</field>
        <field name="arch" type="xml">
            <form string="Éditeur">
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_comic_series" type="object"
                                class="oe_stat_button" icon="fa-folder-open"
                                invisible="not comic_serie_count">
                            <field name="comic_serie_count" widget="statinfo" string="Séries"/>
                        </button>
                        <button name="action_view_comic_works" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="not comic_work_count">
                            <field name="comic_work_count" widget="statinfo" string="Albums"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de l'éditeur"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="pays_id"/>
                            <field name="site_web" widget="url"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="bdgest_editeur_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Séries" name="comic_series">
                            <field name="comic_serie_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="type" optional="show"/>
                                    <field name="statut" optional="show"/>
                                    <field name="nb_works_total" string="Albums"/>
                                </list>
                            </field>
                        </page>
                        <page string="Albums" name="comic_works">
                            <field name="comic_work_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="serie_id"/>
                                    <field name="tome" string="T°"/>
                                    <field name="titre_canonique" string="Titre"/>
                                    <field name="auteur_names" string="Auteurs" optional="show"/>
                                    <field name="date_parution" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_comic_editeur" model="ir.actions.act_window">
        <field name="name">Éditeurs</field>
        <field name="res_model">comic.editeur</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
