<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Menu racine -->
    <menuitem id="menu_comic_root"
              name="Comic Books"
              web_icon="comics_collections,static/description/icon.png"
              groups="comics_collections.group_comic_user"
              sequence="50"/>

    <!-- 1. Ma collection — ce que j'ai -->
    <menuitem id="menu_comic_collection"
              name="My Collection"
              parent="menu_comic_root"
              groups="comics_collections.group_comic_user"
              sequence="10"/>

    <menuitem id="menu_comic_dashboard"
              name="Dashboard"
              parent="menu_comic_collection"
              action="action_comic_collection_dashboard"
              groups="comics_collections.group_comic_user"
              sequence="5"/>

    <menuitem id="menu_comic_series"
              name="My Series"
              parent="menu_comic_collection"
              action="action_comic_serie"
              groups="comics_collections.group_comic_user"
              sequence="10"/>

    <!-- « Mes albums » : ma bibliothèque (état de lecture, note, prix) ; l'ancienne
         entrée « Ma bibliothèque » y est fusionnée. -->
    <menuitem id="menu_comic_albums"
              name="My Albums"
              parent="menu_comic_collection"
              action="action_comic_my_library"
              groups="comics_collections.group_comic_user"
              sequence="20"/>

    <menuitem id="menu_comic_to_read"
              name="To Read"
              parent="menu_comic_collection"
              action="action_comic_to_read"
              groups="comics_collections.group_comic_user"
              sequence="30"/>

    <menuitem id="menu_comic_prets"
              name="Loans"
              parent="menu_comic_collection"
              action="action_comic_pret"
              groups="comics_collections.group_comic_user"
              sequence="40"/>

    <!-- 2. Mes envies — ce qui me manque ou que je veux -->
    <menuitem id="menu_comic_wanted"
              name="Wanted"
              parent="menu_comic_root"
              groups="comics_collections.group_comic_user"
              sequence="15"/>

    <menuitem id="menu_comic_missing"
              name="Missing Volumes"
              parent="menu_comic_wanted"
              action="action_comic_serie_missing"
              groups="comics_collections.group_comic_user"
              sequence="10"/>

    <!-- « Ma wishlist » : comic_wishlist_menu.xml (sequence 20) -->

    <menuitem id="menu_comic_upcoming"
              name="Upcoming"
              parent="menu_comic_wanted"
              action="action_comic_upcoming"
              groups="comics_collections.group_comic_user"
              sequence="30"/>

    <!-- 3. Catalogue — toutes les BD (référentiel commun) -->
    <menuitem id="menu_comic_catalogues"
              name="Catalog"
              parent="menu_comic_root"
              groups="comics_collections.group_comic_user"
              sequence="20"/>

    <!-- Séries et albums de tout le catalogue : gestionnaire dans le cœur (la collection
         est privée, US-087) ; comic_shop les ouvre à tous les utilisateurs BD. -->
    <menuitem id="menu_comic_referentiel_series"
              name="All Series"
              parent="menu_comic_catalogues"
              action="action_comic_serie_catalogue"
              groups="comics_collections.group_comic_manager"
              sequence="5"/>

    <menuitem id="menu_comic_referentiel_albums"
              name="All Albums"
              parent="menu_comic_catalogues"
              action="action_comic_work_catalogue"
              groups="comics_collections.group_comic_manager"
              sequence="6"/>

    <menuitem id="menu_comic_auteurs"
              name="Authors"
              parent="menu_comic_catalogues"
              action="action_comic_auteurs"
              groups="comics_collections.group_comic_user"
              sequence="10"/>

    <menuitem id="menu_comic_editeurs"
              name="Publishers"
              parent="menu_comic_catalogues"
              action="action_comic_editeur"
              groups="comics_collections.group_comic_user"
              sequence="20"/>

    <menuitem id="menu_comic_genres"
              name="Genres"
              parent="menu_comic_catalogues"
              action="action_comic_genre"
              groups="comics_collections.group_comic_user"
              sequence="30"/>

    <menuitem id="menu_comic_editions"
              name="Editions"
              parent="menu_comic_catalogues"
              action="action_comic_edition"
              groups="-comics_collections.group_comic_user,comics_collections.group_comic_manager"
              sequence="40"/>

    <menuitem id="menu_comic_dedup"
              name="Potential Duplicates"
              parent="menu_comic_catalogues"
              action="action_comic_dedup_pair"
              groups="comics_collections.group_comic_manager"
              sequence="50"/>

    <!-- 4. Configuration — import (tous) et réglages (gestionnaire) -->
    <menuitem id="menu_comic_config_root"
              name="Configuration"
              parent="menu_comic_root"
              groups="comics_collections.group_comic_user"
              sequence="90"/>

    <menuitem id="menu_comic_import"
              name="CSV/Excel Import"
              parent="menu_comic_config_root"
              action="action_comic_import_wizard"
              groups="comics_collections.group_comic_user"
              sequence="5"/>

</odoo>
