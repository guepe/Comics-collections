<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Vue liste des paires de doublons ──────────────────────────────────── -->
    <record id="view_comic_dedup_pair_list" model="ir.ui.view">
        <field name="name">comic.dedup.pair.list</field>
        <field name="model">comic.dedup.pair</field>
        <field name="arch" type="xml">
            <list string="Potential duplicates" default_order="score desc"
                  decoration-muted="ignored == True"
                  decoration-danger="reason == 'conflit_certain'"
                  decoration-warning="reason == 'doublon_probable'">
                <field name="score" string="Score" widget="float" digits="[4,3]"/>
                <field name="reason" string="Type"/>
                <field name="work_a_id" string="Album A"/>
                <field name="work_b_id" string="Album B"/>
                <field name="ignored" string="Ignored" optional="hide"/>
                <button name="action_open_merge_wizard"
                        string="Merge A → B"
                        type="object"
                        class="btn-primary btn-sm"
                        invisible="ignored == True"/>
                <button name="action_open_merge_wizard_reverse"
                        string="Merge B → A"
                        type="object"
                        class="btn-primary btn-sm"
                        invisible="ignored == True"/>
                <button name="action_ignore"
                        string="Not a duplicate"
                        type="object"
                        class="btn-secondary btn-sm"
                        invisible="ignored == True"/>
            </list>
        </field>
    </record>

    <!-- ── Vue recherche doublons ─────────────────────────────────────────────── -->
    <record id="view_comic_dedup_pair_search" model="ir.ui.view">
        <field name="name">comic.dedup.pair.search</field>
        <field name="model">comic.dedup.pair</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="work_a_id" string="Album A"/>
                <field name="work_b_id" string="Album B"/>
                <separator/>
                <filter string="To process" name="a_traiter" domain="[('ignored', '=', False)]"/>
                <filter string="Ignored" name="ignores" domain="[('ignored', '=', True)]"/>
                <separator/>
                <filter string="Certain conflicts" name="certains"
                        domain="[('reason', '=', 'conflit_certain')]"/>
                <filter string="Probable duplicates" name="probables"
                        domain="[('reason', '=', 'doublon_probable')]"/>
            </search>
        </field>
    </record>

    <!-- ── Action lancer le scan (serveur) ───────────────────────────────────── -->
    <record id="action_comic_dedup_scan" model="ir.actions.server">
        <field name="name">Scan for duplicates</field>
        <field name="model_id" ref="model_comic_dedup_pair"/>
        <field name="binding_model_id" ref="model_comic_dedup_pair"/>
        <field name="state">code</field>
        <field name="code">action = model.action_scan_all()</field>
        <field name="group_ids" eval="[Command.link(ref('comics_collections.group_comic_manager'))]"/>
    </record>

    <!-- ── Action fenêtre doublons ────────────────────────────────────────────── -->
    <record id="action_comic_dedup_pair" model="ir.actions.act_window">
        <field name="name">Potential Duplicates</field>
        <field name="res_model">comic.dedup.pair</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_comic_dedup_pair_search"/>
        <field name="domain">[('work_a_id.active', '=', True), ('work_b_id.active', '=', True)]</field>
        <field name="context">{'search_default_a_traiter': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No duplicates found.
            </p>
            <p>
                Click <b>Scan for duplicates</b> in the Action menu
                to start detection.
            </p>
        </field>
    </record>

    <!-- ── Vue formulaire wizard fusion ──────────────────────────────────────── -->
    <record id="view_comic_work_merge_wizard_form" model="ir.ui.view">
        <field name="name">comic.work.merge.wizard.form</field>
        <field name="model">comic.work.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge two albums">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        The <b>source</b> album will be archived. Its editions and authors
                        will be transferred to the <b>target</b> album.
                        This operation is <b>irreversible</b> (except by manual restore).
                    </div>
                    <group>
                        <group string="Source album (archived)">
                            <field name="source_work_id"/>
                            <field name="nb_editions_source" readonly="1"/>
                            <field name="nb_auteurs_source" readonly="1"/>
                        </group>
                        <group string="Target album (kept)">
                            <field name="target_work_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_merge"
                            string="Confirm merge"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
