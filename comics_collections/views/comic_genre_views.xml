<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_comic_genre_list" model="ir.ui.view">
        <field name="name">comic.genre.list</field>
        <field name="model">comic.genre</field>
        <field name="arch" type="xml">
            <list string="Genres">
                <field name="color" widget="color_picker" nolabel="1"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_comic_genre_form" model="ir.ui.view">
        <field name="name">comic.genre.form</field>
        <field name="model">comic.genre</field>
        <field name="arch" type="xml">
            <form string="Genre">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_comic_genre" model="ir.actions.act_window">
        <field name="name">Genres</field>
        <field name="res_model">comic.genre</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
