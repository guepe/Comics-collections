<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Vue liste comic.work ─────────────────────────────────────────────── -->
    <record id="view_comic_work_list" model="ir.ui.view">
        <field name="name">comic.work.list</field>
        <field name="model">comic.work</field>
        <field name="arch" type="xml">
            <list string="Œuvres" default_order="serie_id,tome">
                <field name="serie_id"/>
                <field name="tome" string="T°"/>
                <field name="titre_canonique"/>
                <field name="nb_editions" string="Éditions"/>
                <field name="nb_auteurs" string="Auteurs"/>
            </list>
        </field>
    </record>

    <!-- ── Vue formulaire comic.work ───────────────────────────────────────── -->
    <record id="view_comic_work_form" model="ir.ui.view">
        <field name="name">comic.work.form</field>
        <field name="model">comic.work</field>
        <field name="arch" type="xml">
            <form string="Œuvre BD">
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_editions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="nb_editions == 0">
                            <field name="nb_editions" widget="statinfo" string="Éditions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="titre_canonique" string="Titre canonique"/>
                        <h1>
                            <field name="titre_canonique" placeholder="Titre canonique"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="serie_id"/>
                            <field name="tome"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Auteurs">
                            <field name="auteur_line_ids">
                                <list editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="role"/>
                                </list>
                            </field>
                        </page>
                        <page string="Éditions">
                            <field name="edition_ids">
                                <list>
                                    <field name="langue"/>
                                    <field name="format"/>
                                    <field name="editeur_id"/>
                                    <field name="date_parution"/>
                                    <field name="nb_pages"/>
                                    <field name="nb_isbn" string="ISBN"/>
                                </list>
                            </field>
                        </page>
                        <page string="Références">
                            <group>
                                <field name="slug"/>
                                <field name="wikidata_id"/>
                                <field name="openlibrary_id"/>
                                <field name="bedetheque_id"/>
                                <field name="comicvine_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Vue recherche comic.work ────────────────────────────────────────── -->
    <record id="view_comic_work_search" model="ir.ui.view">
        <field name="name">comic.work.search</field>
        <field name="model">comic.work</field>
        <field name="arch" type="xml">
            <search string="Rechercher une œuvre">
                <field name="titre_canonique" string="Titre"/>
                <field name="serie_id"/>
                <field name="tome"/>
                <field name="slug"/>
                <field name="wikidata_id" string="Wikidata"/>
                <field name="auteur_line_ids" string="Auteur"
                       filter_domain="[('auteur_line_ids.partner_id.name', 'ilike', self)]"/>
                <separator/>
                <filter string="Sans édition" name="sans_edition"
                        domain="[('nb_editions', '=', 0)]"/>
                <group name="group_by">
                    <filter string="Série" name="groupby_serie" context="{'group_by': 'serie_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action comic.work ───────────────────────────────────────────────── -->
    <record id="action_comic_work" model="ir.actions.act_window">
        <field name="name">Albums / Tomes</field>
        <field name="res_model">comic.work</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_comic_work_search"/>
    </record>

</odoo>
