<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Vue liste Albums / Tomes ──────────────────────────────────────────── -->
    <record id="view_comic_work_list" model="ir.ui.view">
        <field name="name">comic.work.list</field>
        <field name="model">comic.work</field>
        <field name="arch" type="xml">
            <list string="Albums" default_order="serie_id,tome" default_group_by="serie_id">
                <field name="image_couverture" string=" " widget="image"
                       options="{'size': [32, 48]}" width="44px"/>
                <field name="serie_id" optional="hide"/>
                <field name="tome" string="T°" width="50px"/>
                <field name="titre_canonique" string="Titre"/>
                <field name="auteur_names" string="Auteurs"/>
                <field name="editeur_id" optional="show"/>
                <field name="date_parution" optional="show"/>
                <field name="nb_editions" string="Versions" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Variante sans groupement : albums d'UNE série (bouton « Albums » de la fiche série) -->
    <record id="view_comic_work_list_serie" model="ir.ui.view">
        <field name="name">comic.work.list.serie</field>
        <field name="model">comic.work</field>
        <field name="inherit_id" ref="view_comic_work_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_group_by"></attribute>
            </xpath>
        </field>
    </record>

    <!-- ── Vue kanban Albums / Tomes ─────────────────────────────────────────── -->
    <record id="view_comic_work_kanban" model="ir.ui.view">
        <field name="name">comic.work.kanban</field>
        <field name="model">comic.work</field>
        <field name="arch" type="xml">
            <kanban class="o_comic_kanban_series" sample="1" default_order="serie_id,tome">
                <field name="id"/>
                <field name="titre_canonique"/>
                <field name="tome"/>
                <field name="serie_id"/>
                <field name="image_couverture"/>
                <field name="editeur_id"/>
                <field name="primary_edition_id"/>
                <templates>
                    <t t-name="card">
                        <div class="o_comic_serie_card">
                            <div class="o_comic_serie_cover">
                                <t t-if="record.image_couverture.raw_value">
                                    <img loading="lazy"
                                         t-att-src="'/web/image/comic.work/' + record.id.raw_value + '/image_couverture'"
                                         t-att-alt="record.titre_canonique.value"/>
                                </t>
                                <t t-else="">
                                    <div class="o_comic_serie_placeholder">
                                        <span t-esc="record.titre_canonique.value"/>
                                    </div>
                                </t>
                                <t t-if="record.tome.raw_value">
                                    <span class="o_comic_serie_statut" style="background:#1a73e8;">
                                        T<t t-esc="record.tome.raw_value"/>
                                    </span>
                                </t>
                            </div>
                            <div class="o_comic_serie_info">
                                <div class="o_comic_serie_title" t-esc="record.titre_canonique.value"/>
                                <div class="o_comic_serie_meta">
                                    <t t-esc="record.serie_id.value || ''"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Vue formulaire Album (tout-en-un) ─────────────────────────────────── -->
    <record id="view_comic_work_form" model="ir.ui.view">
        <field name="name">comic.work.form</field>
        <field name="model">comic.work</field>
        <field name="arch" type="xml">
            <form string="Album BD">
                <sheet>
                    <!-- Smartbutton éditions multiples (uniquement si > 1) -->
                    <div name="button_box" class="oe_button_box">
                        <!-- Dans la button box : comic_shop ajoute déjà un <header> avant la feuille -->
                        <button name="action_add_to_my_wishlist"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-heart-o"
                                string="Ajouter à ma wishlist"
                                invisible="not id"/>
                        <button name="action_view_editions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-clone"
                                invisible="nb_editions &lt;= 1">
                            <field name="nb_editions" widget="statinfo" string="Versions"/>
                        </button>
                    </div>

                    <!-- Couverture + titre -->
                    <field name="image_couverture" widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'image_couverture', 'size': [128, 192]}"/>
                    <div class="oe_title">
                        <label for="serie_id" string="Série"/>
                        <h2>
                            <field name="serie_id" placeholder="Série…"/>
                            <span class="ms-2">T°</span>
                            <field name="tome" class="d-inline-block ms-1" style="width:4rem;" placeholder="—"/>
                        </h2>
                        <label for="titre_canonique" string="Titre"/>
                        <h1>
                            <field name="titre_canonique" placeholder="Titre de l'album"/>
                        </h1>
                    </div>

                    <field name="primary_edition_id" invisible="1"/>

                    <!-- Infos éditoriales -->
                    <group>
                        <group>
                            <field name="editeur_id"/>
                            <field name="langue"/>
                            <field name="format"/>
                        </group>
                        <group>
                            <field name="date_parution"/>
                            <field name="nb_pages"/>
                            <field name="nb_auteurs" string="Nb auteurs" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Auteurs -->
                        <page string="Auteurs">
                            <field name="auteur_line_ids">
                                <list editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="role"/>
                                </list>
                            </field>
                        </page>

                        <!-- ISBNs -->
                        <page string="ISBNs">
                            <field name="isbn_ids">
                                <list editable="bottom">
                                    <field name="isbn_13"/>
                                    <field name="isbn_10"/>
                                </list>
                            </field>
                        </page>

                        <!-- Synopsis -->
                        <page string="Synopsis">
                            <field name="synopsis" nolabel="1"/>
                        </page>

                        <!-- Liens d'achat -->
                        <page string="Liens d'achat">
                            <button name="action_generate_purchase_links"
                                    string="Générer les liens depuis l'ISBN"
                                    type="object"
                                    class="btn-secondary mb-3"
                                    confirm="Générer les liens d'achat depuis l'ISBN principal ?"
                                    groups="comics_collections.group_comic_manager"/>
                            <group>
                                <field name="url_club_be" widget="url"/>
                                <field name="url_amazon_be" widget="url"/>
                                <field name="url_fnac_be" widget="url"/>
                            </group>
                        </page>

                        <!-- Éditions multiples (masqué si une seule édition) — libellé utilisateur : "versions" -->
                        <page string="Autres versions" name="editions_multiples" invisible="nb_editions &lt;= 1">
                            <field name="edition_ids">
                                <list>
                                    <field name="langue"/>
                                    <field name="format"/>
                                    <field name="editeur_id"/>
                                    <field name="date_parution"/>
                                    <field name="nb_pages"/>
                                    <field name="nb_isbn" string="ISBN"/>
                                </list>
                            </field>
                        </page>

                        <!-- Références (données techniques) -->
                        <page string="Références">
                            <group>
                                <field name="slug"/>
                                <field name="wikidata_id"/>
                                <field name="openlibrary_id"/>
                                <field name="bedetheque_id"/>
                                <field name="comicvine_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Vue recherche ─────────────────────────────────────────────────────── -->
    <record id="view_comic_work_search" model="ir.ui.view">
        <field name="name">comic.work.search</field>
        <field name="model">comic.work</field>
        <field name="arch" type="xml">
            <search string="Rechercher un album">
                <field name="titre_canonique" string="Titre"/>
                <field name="serie_id"/>
                <field name="tome"/>
                <field name="editeur_id"/>
                <field name="auteur_line_ids" string="Auteur"
                       filter_domain="[('auteur_line_ids.partner_id.name', 'ilike', self)]"/>
                <field name="edition_ids" string="ISBN"
                       filter_domain="[('edition_ids.isbn_ids.isbn_13', 'ilike', self)]"/>
                <separator/>
                <filter string="Ma collection" name="ma_collection"
                        domain="[('edition_ids.customer_album_ids', 'any', [('partner_id.user_ids', 'in', [uid]), ('dans_collection', '=', True)])]"/>
                <filter string="Ma wishlist" name="ma_wishlist"
                        domain="[('edition_ids.customer_album_ids', 'any', [('partner_id.user_ids', 'in', [uid]), ('dans_wishlist', '=', True)])]"/>
                <filter string="Prêtés" name="pretes"
                        domain="[('edition_ids.pret_ids', 'any', [('retourne', '=', False)])]"/>
                <separator/>
                <filter string="Note ≥ 3★" name="note_3"
                        domain="[('edition_ids.customer_album_ids', 'any', [('partner_id.user_ids', 'in', [uid]), ('note', '>=', 3)])]"/>
                <filter string="Note ≥ 4★" name="note_4"
                        domain="[('edition_ids.customer_album_ids', 'any', [('partner_id.user_ids', 'in', [uid]), ('note', '>=', 4)])]"/>
                <separator/>
                <filter string="Sans couverture" name="sans_couverture"
                        domain="[('image_couverture', '=', False)]"/>
                <filter string="Sans ISBN" name="sans_isbn"
                        domain="[('isbn_ids', '=', False)]"/>
                <filter string="Sans édition" name="sans_edition"
                        domain="[('edition_ids', '=', False)]"/>
                <group name="group_by">
                    <filter string="Série" name="groupby_serie" context="{'group_by': 'serie_id'}"/>
                    <filter string="Éditeur" name="groupby_editeur" context="{'group_by': 'editeur_id'}"/>
                    <filter string="Genre" name="groupby_genre" context="{'group_by': 'genre_id'}"/>
                    <filter string="Type de série" name="groupby_serie_type" context="{'group_by': 'serie_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────────────── -->
    <record id="action_comic_work" model="ir.actions.act_window">
        <field name="name">Albums / Tomes</field>
        <field name="res_model">comic.work</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_comic_work_search"/>
        <!-- Groupement par série porté par la vue liste (default_group_by) :
             la galerie kanban reste une grille, sans une colonne par série. -->
        <field name="context">{'search_default_ma_collection': 1}</field>
    </record>

    <!-- Catalogue partagé complet (sans filtre « Ma collection ») -->
    <record id="action_comic_work_catalogue" model="ir.actions.act_window">
        <field name="name">Tous les albums</field>
        <field name="res_model">comic.work</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_comic_work_search"/>
        <field name="context">{}</field>
    </record>

</odoo>
