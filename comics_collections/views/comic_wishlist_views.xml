<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ma wishlist (US-089) : manques des séries suivies + souhaits manuels.
         Le menu est déclaré dans comic_wishlist_menu.xml (chargé après comic_menu.xml,
         où est défini le menu parent « Ma Collection »). -->

    <record id="view_comic_wishlist_item_list" model="ir.ui.view">
        <field name="name">comic.wishlist.item.list</field>
        <field name="model">comic.wishlist.item</field>
        <field name="arch" type="xml">
            <!-- Clic sur une ligne : ouvre la fiche de l'album -->
            <list string="My Wishlist" create="false" edit="false" delete="false"
                  default_group_by="serie_id" default_order="serie_id,tome"
                  action="action_open_work" type="object">
                <field name="image_couverture" widget="image" options="{'size': [0, 48]}"
                       string="Cover" optional="show"/>
                <field name="serie_id"/>
                <field name="tome"/>
                <field name="work_id"/>
                <field name="date_parution"/>
                <field name="type" widget="badge"
                       decoration-danger="type == 'manque'"
                       decoration-info="type == 'souhait'"/>
                <button name="action_mark_owned" type="object" icon="fa-check"
                        string="I have it" title="I have it: add to my collection"/>
                <button name="action_ignore" type="object" icon="fa-eye-slash"
                        string="Ignore" title="Ignore this volume (don't buy)"
                        invisible="type != 'manque'"/>
                <button name="action_remove" type="object" icon="fa-times"
                        string="Remove" title="Remove from my wishlist"
                        invisible="type != 'souhait'"/>
                <button name="action_remove" type="object" icon="fa-times"
                        string="Remove" title="Unfollow this series"
                        confirm="Unfollow this series?"
                        invisible="type != 'manque'"/>
            </list>
        </field>
    </record>

    <record id="view_comic_wishlist_item_kanban" model="ir.ui.view">
        <field name="name">comic.wishlist.item.kanban</field>
        <field name="model">comic.wishlist.item</field>
        <field name="arch" type="xml">
            <kanban class="o_comic_kanban_series" create="false" default_order="serie_id,tome"
                    action="action_open_work" type="object">
                <field name="type"/>
                <field name="tome"/>
                <templates>
                    <t t-name="card">
                        <div class="o_comic_serie_card">
                            <div class="o_comic_serie_cover">
                                <field name="image_couverture" widget="image"
                                       options="{'size': [0, 180]}" alt="Cover"/>
                                <span t-if="record.tome.raw_value" class="o_comic_serie_statut"
                                      style="background:#1a73e8;">
                                    Vol. <t t-esc="record.tome.raw_value"/>
                                </span>
                            </div>
                            <div class="o_comic_serie_info">
                                <div class="o_comic_serie_title"><field name="work_id"/></div>
                                <div class="o_comic_serie_meta">
                                    <field name="serie_id"/>
                                </div>
                                <div class="d-flex align-items-center gap-1 mt-1">
                                    <field name="type" widget="badge"
                                           decoration-danger="type == 'manque'"
                                           decoration-info="type == 'souhait'"/>
                                    <field name="date_parution" class="text-muted small"/>
                                </div>
                                <div class="d-flex gap-1 mt-2">
                                    <button name="action_mark_owned" type="object"
                                            class="btn btn-sm btn-primary" title="I have it">
                                        <i class="fa fa-check"/> I have it
                                    </button>
                                    <button name="action_ignore" type="object"
                                            class="btn btn-sm btn-secondary" title="Ignore this volume"
                                            invisible="type != 'manque'">
                                        <i class="fa fa-eye-slash"/>
                                    </button>
                                    <button name="action_remove" type="object"
                                            class="btn btn-sm btn-secondary" title="Remove from my wishlist"
                                            invisible="type != 'souhait'">
                                        <i class="fa fa-times"/>
                                    </button>
                                    <button name="action_remove" type="object"
                                            class="btn btn-sm btn-secondary" title="Unfollow this series"
                                            confirm="Unfollow this series?"
                                            invisible="type != 'manque'">
                                        <i class="fa fa-times"/>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Grandes couvertures : onglets « Souhaits » et « Sorties » -->
    <record id="view_comic_wishlist_item_kanban_covers" model="ir.ui.view">
        <field name="name">comic.wishlist.item.kanban.covers</field>
        <field name="model">comic.wishlist.item</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban class="o_comic_kanban_covers" create="false" default_order="serie_id,tome,work_id"
                    action="action_open_work" type="object">
                <field name="work_id"/>
                <field name="serie_id"/>
                <field name="type"/>
                <field name="tome"/>
                <field name="date_parution"/>
                <templates>
                    <t t-name="card">
                        <div class="o_comic_cover_card">
                            <div class="o_comic_cover_card_img">
                                <field name="image_couverture" widget="image" alt="Cover"/>
                            </div>
                            <div class="o_comic_cover_card_title">
                                <t t-esc="record.serie_id.value"/>
                                <span t-if="record.tome.raw_value" class="o_comic_cover_card_tome">Vol. <t t-esc="record.tome.raw_value"/></span>
                            </div>
                            <div class="o_comic_cover_card_meta" t-esc="record.work_id.value"/>
                            <div t-if="record.date_parution.raw_value" class="o_comic_cover_card_date">
                                <i class="fa fa-calendar" title="Release date"/> <field name="date_parution"/>
                            </div>
                            <div class="d-flex gap-1 mt-2">
                                <button name="action_mark_owned" type="object"
                                        class="btn btn-sm btn-primary" title="I have it: add to my collection">
                                    <i class="fa fa-check"/> I have it
                                </button>
                                <button name="action_remove" type="object"
                                        class="btn btn-sm btn-outline-secondary" title="Remove from my wishlist"
                                        invisible="type != 'souhait'">
                                    <i class="fa fa-times"/>
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_comic_wishlist_item_kanban_upcoming" model="ir.ui.view">
        <field name="name">comic.wishlist.item.kanban.upcoming</field>
        <field name="model">comic.wishlist.item</field>
        <field name="inherit_id" ref="view_comic_wishlist_item_kanban_covers"/>
        <field name="mode">primary</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_order">date_parution,serie_id,tome</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_comic_wishlist_item_search" model="ir.ui.view">
        <field name="name">comic.wishlist.item.search</field>
        <field name="model">comic.wishlist.item</field>
        <field name="arch" type="xml">
            <search string="My Wishlist">
                <field name="serie_id"/>
                <field name="work_id"/>
                <filter string="Missing" name="manque" domain="[('type', '=', 'manque')]"/>
                <filter string="Wishes" name="souhait" domain="[('type', '=', 'souhait')]"/>
                <separator/>
                <filter string="Upcoming" name="a_paraitre"
                        domain="[('date_parution', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Released" name="parus"
                        domain="[('date_parution', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group name="group_by">
                    <filter string="Series" name="group_serie" context="{'group_by': 'serie_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_comic_wishlist" model="ir.actions.act_window">
        <field name="name">My Wishlist</field>
        <field name="res_model">comic.wishlist.item</field>
        <field name="view_mode">list,kanban</field>
        <field name="search_view_id" ref="view_comic_wishlist_item_search"/>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Your wishlist is empty.
            </p>
            <p>
                Follow a series to see the volumes you are missing, or add
                an album to your wishlist yourself from your library.
            </p>
        </field>
    </record>

    <!-- « Sorties » : albums à paraître des séries suivies (manques) ou souhaités -->
    <record id="action_comic_upcoming" model="ir.actions.act_window">
        <field name="name">Upcoming</field>
        <field name="res_model">comic.wishlist.item</field>
        <field name="view_mode">kanban,list</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'kanban', 'view_id': ref('view_comic_wishlist_item_kanban_upcoming')}),
            Command.create({'view_mode': 'list', 'view_id': ref('view_comic_wishlist_item_list')})]"/>
        <field name="search_view_id" ref="view_comic_wishlist_item_search"/>
        <field name="domain">[('user_id', '=', uid), ('is_upcoming', '=', True)]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No upcoming release.
            </p>
            <p>
                Albums to be released in the series you follow, or that you wish for,
                appear here by release date.
            </p>
        </field>
    </record>

    <!-- « Souhaits » : souhaits manuels de la wishlist, en grandes couvertures -->
    <record id="action_comic_wishes" model="ir.actions.act_window">
        <field name="name">Wishes</field>
        <field name="res_model">comic.wishlist.item</field>
        <field name="view_mode">kanban,list</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'kanban', 'view_id': ref('view_comic_wishlist_item_kanban_covers')}),
            Command.create({'view_mode': 'list', 'view_id': ref('view_comic_wishlist_item_list')})]"/>
        <field name="search_view_id" ref="view_comic_wishlist_item_search"/>
        <field name="domain">[('user_id', '=', uid), ('type', '=', 'souhait')]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No wishes yet.
            </p>
            <p>
                Add an album to your wishlist from its form ("Add to my wishlist")
                or from your library.
            </p>
        </field>
    </record>

</odoo>
