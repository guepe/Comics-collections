<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bibliothèque personnelle : ce que chaque utilisateur possède, souhaite, lit et note -->

    <record id="view_comic_customer_album_list" model="ir.ui.view">
        <field name="name">comic.customer.album.list</field>
        <field name="model">comic.customer.album</field>
        <field name="arch" type="xml">
            <list string="Library">
                <field name="partner_id" optional="hide"/>
                <field name="serie_id" optional="show"/>
                <field name="tome" optional="show"/>
                <field name="edition_id"/>
                <field name="source" optional="show"/>
                <field name="etat_lecture"/>
                <field name="dans_collection"/>
                <field name="dans_wishlist"/>
                <field name="note_etoiles" widget="priority"/>
                <field name="note" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="prix_achat" optional="show" sum="Total purchase price"/>
                <field name="valeur_estimee" optional="show" sum="Total estimated value"/>
                <field name="date_ajout"/>
            </list>
        </field>
    </record>

    <!-- Galerie : même présentation que « Mes albums » (couverture, tome, série),
         plus l'état de lecture, les étoiles et la wishlist -->
    <record id="view_comic_customer_album_kanban" model="ir.ui.view">
        <field name="name">comic.customer.album.kanban</field>
        <field name="model">comic.customer.album</field>
        <field name="arch" type="xml">
            <kanban class="o_comic_kanban_series" sample="1" default_order="serie_id,tome,id">
                <field name="id"/>
                <field name="edition_id"/>
                <field name="work_id"/>
                <field name="serie_id"/>
                <field name="tome"/>
                <field name="image_couverture"/>
                <field name="etat_lecture"/>
                <field name="dans_collection"/>
                <field name="dans_wishlist"/>
                <templates>
                    <t t-name="card">
                        <div class="o_comic_serie_card">
                            <div class="o_comic_serie_cover">
                                <t t-if="record.image_couverture.raw_value">
                                    <img loading="lazy"
                                         t-att-src="'/web/image/comic.edition/' + record.edition_id.raw_value + '/image_couverture'"
                                         t-att-alt="record.work_id.value"/>
                                </t>
                                <t t-else="">
                                    <div class="o_comic_serie_placeholder">
                                        <span t-esc="record.work_id.value"/>
                                    </div>
                                </t>
                                <t t-if="record.tome.raw_value">
                                    <span class="o_comic_serie_statut" style="background:#1a73e8;">
                                        Vol. <t t-esc="record.tome.raw_value"/>
                                    </span>
                                </t>
                            </div>
                            <div class="o_comic_serie_info">
                                <div class="o_comic_serie_title" t-esc="record.work_id.value"/>
                                <div class="o_comic_serie_meta">
                                    <t t-esc="record.serie_id.value || ''"/>
                                </div>
                                <div class="d-flex align-items-center justify-content-between">
                                    <field name="note_etoiles" widget="priority" readonly="1"/>
                                    <span>
                                        <i t-if="record.dans_wishlist.raw_value and !record.dans_collection.raw_value"
                                           class="fa fa-heart text-danger" title="In wishlist"/>
                                        <span t-if="record.etat_lecture.raw_value == 'lu'"
                                              class="badge text-bg-success ms-1">Read</span>
                                        <span t-elif="record.etat_lecture.raw_value == 'en_cours'"
                                              class="badge text-bg-warning ms-1">Reading</span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- « Pile à lire » en lignes (même style que « Mes séries ») -->
    <record id="view_comic_customer_album_kanban_rows" model="ir.ui.view">
        <field name="name">comic.customer.album.kanban.rows</field>
        <field name="model">comic.customer.album</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <kanban class="o_comic_kanban_rows" default_order="serie_id,tome,id">
                <field name="id"/>
                <field name="work_titre"/>
                <field name="edition_id"/>
                <field name="work_id"/>
                <field name="serie_id"/>
                <field name="tome"/>
                <field name="image_couverture"/>
                <field name="etat_lecture"/>
                <templates>
                    <t t-name="card">
                        <div class="o_comic_row">
                            <div class="o_comic_row_cover">
                                <img t-if="record.image_couverture.raw_value" loading="lazy"
                                     t-att-src="'/web/image/comic.edition/' + record.edition_id.raw_value + '/image_couverture'"
                                     t-att-alt="record.work_id.value"/>
                                <div t-else="" class="o_comic_row_placeholder">
                                    <span t-esc="record.tome.raw_value or (record.serie_id.value || '?')[0]"/>
                                </div>
                            </div>
                            <div class="o_comic_row_main">
                                <div class="o_comic_row_title" t-esc="record.serie_id.value or record.work_id.value"/>
                                <div class="o_comic_row_meta">
                                    <t t-if="record.tome.raw_value">Vol. <t t-esc="record.tome.raw_value"/> · </t>
                                    <t t-esc="record.work_titre.value or record.work_id.value"/>
                                </div>
                                <div class="o_comic_row_stars">
                                    <field name="note_etoiles" widget="priority"/>
                                </div>
                            </div>
                            <div class="o_comic_row_stat">
                                <span t-if="record.etat_lecture.raw_value == 'lu'" class="badge text-bg-success">Read</span>
                                <span t-elif="record.etat_lecture.raw_value == 'en_cours'" class="badge text-bg-warning">Reading</span>
                                <span t-else="" class="badge text-bg-light">Unread</span>
                            </div>
                            <div class="o_comic_row_actions o_comic_row_actions_fixed">
                                <button name="action_set_reading" type="object" class="btn btn-sm btn-outline-secondary"
                                        title="I'm reading it" invisible="etat_lecture != 'non_lu'">
                                    <i class="fa fa-book"/> Reading
                                </button>
                                <button name="action_set_read" type="object" class="btn btn-sm btn-primary"
                                        title="Mark as read" invisible="etat_lecture == 'lu'">
                                    <i class="fa fa-check"/> Read
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_comic_customer_album_form" model="ir.ui.view">
        <field name="name">comic.customer.album.form</field>
        <field name="model">comic.customer.album</field>
        <field name="arch" type="xml">
            <form string="Library">
                <sheet>
                    <group name="main">
                        <group string="Identification" name="identification">
                            <field name="partner_id"/>
                            <field name="edition_id"/>
                            <field name="source"/>
                            <field name="date_ajout"/>
                        </group>
                        <group string="My collection" name="ma_collection">
                            <field name="dans_collection"/>
                            <field name="dans_wishlist"/>
                            <field name="ignore_wishlist"/>
                            <field name="etat_lecture"/>
                            <field name="note_etoiles" widget="priority"/>
                            <field name="note" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <group name="valeur">
                        <group string="Value" name="valeur_montants">
                            <field name="currency_id" invisible="1"/>
                            <field name="prix_achat"/>
                            <field name="valeur_estimee"/>
                        </group>
                    </group>
                    <group name="commentaire">
                        <field name="commentaire"
                               placeholder="Personal notes..."
                               nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_comic_customer_album_search" model="ir.ui.view">
        <field name="name">comic.customer.album.search</field>
        <field name="model">comic.customer.album</field>
        <field name="arch" type="xml">
            <search string="Library">
                <field name="edition_id" string="Album"/>
                <field name="work_id" string="Title"/>
                <field name="partner_id" string="Owner"/>
                <filter string="In collection" name="collection"
                        domain="[('dans_collection', '=', True)]"/>
                <filter string="In wishlist" name="wishlist"
                        domain="[('dans_wishlist', '=', True)]"/>
                <separator/>
                <filter string="Unread" name="non_lu" domain="[('etat_lecture', '=', 'non_lu')]"/>
                <filter string="Reading" name="en_cours" domain="[('etat_lecture', '=', 'en_cours')]"/>
                <filter string="Read" name="lu" domain="[('etat_lecture', '=', 'lu')]"/>
                <separator/>
                <filter string="Rating ≥ 3★" name="note_3" domain="[('note', '>=', 3)]"/>
                <filter string="Rating ≥ 4★" name="note_4" domain="[('note', '>=', 4)]"/>
                <group name="group_by">
                    <filter string="Owner" name="by_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Source" name="by_source"
                            context="{'group_by': 'source'}"/>
                    <filter string="Reading status" name="by_etat"
                            context="{'group_by': 'etat_lecture'}"/>
                    <filter string="Genre" name="by_genre"
                            context="{'group_by': 'genre_id'}"/>
                    <filter string="Series" name="by_serie"
                            context="{'group_by': 'serie_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_comic_my_library" model="ir.actions.act_window">
        <field name="name">My Albums</field>
        <field name="res_model">comic.customer.album</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'kanban', 'view_id': ref('view_comic_customer_album_kanban_rows')}),
            Command.create({'view_mode': 'list', 'view_id': ref('view_comic_customer_album_list')}),
            Command.create({'view_mode': 'form', 'view_id': ref('view_comic_customer_album_form')})]"/>
        <field name="search_view_id" ref="view_comic_customer_album_search"/>
        <field name="domain">[('partner_id.user_ids', 'in', [uid])]</field>
        <field name="context">{'search_default_collection': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Your library is empty.
            </p>
            <p>
                Add albums to your collection or to your wishlist from the album
                list (“Mark as Read” action) or through CSV/Excel import.
            </p>
        </field>
    </record>

    <!-- « À lire » (pile à lire) : mes albums possédés pas encore lus -->
    <record id="action_comic_to_read" model="ir.actions.act_window">
        <field name="name">To Read</field>
        <field name="res_model">comic.customer.album</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'kanban', 'view_id': ref('view_comic_customer_album_kanban_rows')}),
            Command.create({'view_mode': 'list', 'view_id': ref('view_comic_customer_album_list')}),
            Command.create({'view_mode': 'form', 'view_id': ref('view_comic_customer_album_form')})]"/>
        <field name="search_view_id" ref="view_comic_customer_album_search"/>
        <field name="domain">[('partner_id.user_ids', 'in', [uid]), ('dans_collection', '=', True), ('etat_lecture', '!=', 'lu')]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nothing left to read.
            </p>
            <p>
                Every album of your collection is marked as read.
            </p>
        </field>
    </record>

</odoo>
