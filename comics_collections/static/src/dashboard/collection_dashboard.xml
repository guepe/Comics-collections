<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="comics_collections.CollectionDashboard">
        <Layout display="display" className="'o_comic_dashboard'">
            <t t-set="data" t-value="state.data"/>
            <div class="o_comic_dashboard_content container-fluid py-3 px-lg-4">

                <!-- État vide -->
                <div t-if="isEmpty" class="o_view_nocontent">
                    <div class="o_nocontent_help">
                        <p class="o_view_nocontent_smiling_face">Votre bibliothèque est encore vide</p>
                        <p>
                            Ajoutez vos albums depuis la liste des albums, ou importez votre collection
                            depuis un fichier CSV ou Excel.
                        </p>
                        <p>
                            <button type="button" class="btn btn-primary me-2" t-on-click="openCatalogue">Parcourir les albums</button>
                            <button type="button" class="btn btn-secondary" t-on-click="openImport">Importer un fichier</button>
                        </p>
                    </div>
                </div>

                <t t-else="">
                    <!-- Indicateurs -->
                    <div class="row g-3 mb-3">
                        <t t-foreach="kpis" t-as="kpi" t-key="kpi.key">
                            <div class="col-6 col-lg-3">
                                <div class="card h-100 o_comic_kpi" role="button" t-on-click="kpi.onClick"
                                     t-att-data-kpi="kpi.key">
                                    <div class="card-body d-flex align-items-center gap-3">
                                        <span t-attf-class="o_comic_kpi_icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-bg-{{kpi.color}}">
                                            <i t-attf-class="fa fa-fw {{kpi.icon}}" aria-hidden="true"/>
                                        </span>
                                        <div class="min-w-0">
                                            <div class="text-muted small text-truncate" t-esc="kpi.label"/>
                                            <div t-attf-class="fs-3 fw-bold lh-sm {{kpi.alert ? 'text-danger' : ''}}" t-esc="kpi.value"/>
                                            <div class="text-muted small text-truncate" t-esc="kpi.hint"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Répartitions -->
                    <div class="row g-3 mb-3">
                        <div class="col-lg-6">
                            <div class="card h-100">
                                <div class="card-header bg-transparent fw-bold">Albums par genre</div>
                                <div class="card-body">
                                    <t t-foreach="data.by_genre" t-as="row" t-key="row.label">
                                        <div class="d-flex justify-content-between small mb-1">
                                            <span t-esc="row.label"/>
                                            <span class="text-muted"><t t-esc="row.count"/> (<t t-esc="row.percent"/> %)</span>
                                        </div>
                                        <div class="progress mb-3" role="progressbar" t-att-aria-valuenow="row.percent"
                                             aria-valuemin="0" aria-valuemax="100" t-att-aria-label="row.label">
                                            <div class="progress-bar bg-primary" t-attf-style="width: {{row.percent}}%"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="card h-100">
                                <div class="card-header bg-transparent fw-bold">État de lecture</div>
                                <div class="card-body">
                                    <t t-foreach="data.by_reading" t-as="row" t-key="row.key">
                                        <div class="d-flex justify-content-between small mb-1">
                                            <span t-esc="row.label"/>
                                            <span class="text-muted"><t t-esc="row.count"/> (<t t-esc="row.percent"/> %)</span>
                                        </div>
                                        <div class="progress mb-3" role="progressbar" t-att-aria-valuenow="row.percent"
                                             aria-valuemin="0" aria-valuemax="100" t-att-aria-label="row.label">
                                            <div t-attf-class="progress-bar {{readingColors[row.key]}}" t-attf-style="width: {{row.percent}}%"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Listes -->
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <div class="card h-100">
                                <div class="card-header bg-transparent fw-bold">Séries les mieux notées</div>
                                <div t-if="!data.top_series.length" class="card-body text-muted small">
                                    Notez vos albums dans « Ma bibliothèque » pour voir apparaître vos séries préférées.
                                </div>
                                <div t-else="" class="list-group list-group-flush">
                                    <a t-foreach="data.top_series" t-as="serie" t-key="serie.id" href="#"
                                       class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                                       t-on-click.prevent="() => this.openRecord('comic.serie', serie.id)">
                                        <span class="badge rounded-pill text-bg-light" t-esc="serie_index + 1"/>
                                        <span class="flex-grow-1 text-truncate" t-esc="serie.name"/>
                                        <span class="text-nowrap">
                                            <i class="fa fa-star text-warning" aria-hidden="true"/>
                                            <t t-esc="serie.note"/>
                                            <small class="text-muted">(<t t-esc="serie.count"/>)</small>
                                        </span>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="card h-100">
                                <div class="card-header bg-transparent fw-bold">Derniers ajouts</div>
                                <div t-if="!data.recent.length" class="card-body text-muted small">Aucun album possédé.</div>
                                <div t-else="" class="list-group list-group-flush">
                                    <a t-foreach="data.recent" t-as="album" t-key="album.id" href="#"
                                       class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                                       t-on-click.prevent="() => this.openRecord('comic.work', album.work_id)">
                                        <i class="fa fa-book text-muted" aria-hidden="true"/>
                                        <span class="flex-grow-1 text-truncate" t-esc="album.name"/>
                                        <small class="text-muted text-nowrap" t-esc="formatDate(album.date)"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </Layout>
    </t>

</templates>
