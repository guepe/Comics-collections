<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inventaire de la collection (US-071) : imprimable depuis « Ma bibliothèque »
         et depuis le tableau de bord (action_print_my_inventory). -->
    <record id="action_report_comic_collection_inventory" model="ir.actions.report">
        <field name="name">My Collection Inventory</field>
        <field name="model">comic.customer.album</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">comics_collections.report_comic_collection_inventory</field>
        <field name="report_file">comics_collections.report_comic_collection_inventory</field>
        <field name="print_report_name">'Collection inventory'</field>
        <field name="binding_model_id" ref="model_comic_customer_album"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_comic_collection_inventory">
        <t t-call="web.html_container">
            <t t-set="inventory" t-value="docs._get_inventory_data()"/>
            <t t-set="currency" t-value="inventory['currency']"/>
            <t t-call="web.external_layout">
                <div class="page o_comic_inventory">
                    <h2>My Collection Inventory</h2>
                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Owner:</strong>
                            <span t-out="inventory['owners']"/>
                        </div>
                        <div class="col-6 text-end">
                            <strong>Date:</strong>
                            <span t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                        </div>
                    </div>

                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th class="text-end">Volume</th>
                                <th>Title</th>
                                <th>ISBN</th>
                                <th>Reading status</th>
                                <th class="text-end">Rating</th>
                                <th class="text-end">Purchase price</th>
                                <th class="text-end">Estimated value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="inventory['series']" t-as="serie">
                                <tr class="o_comic_inventory_serie">
                                    <td colspan="7"><strong t-out="serie['name']"/></td>
                                </tr>
                                <tr t-foreach="serie['lines']" t-as="line">
                                    <td class="text-end" t-out="line['tome']"/>
                                    <td t-out="line['titre']"/>
                                    <td t-out="line['isbn']"/>
                                    <td t-out="line['etat_lecture']"/>
                                    <td class="text-end">
                                        <t t-if="line['note']" t-out="'%.1f' % line['note']"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-if="line['prix_achat']" t-out="line['prix_achat']"
                                           t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-if="line['valeur_estimee']" t-out="line['valeur_estimee']"
                                           t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                </tr>
                                <tr class="o_comic_inventory_subtotal">
                                    <td colspan="5" class="text-end">
                                        <em>Subtotal <t t-out="serie['name']"/>
                                            (<t t-out="serie['count']"/> <t t-if="serie['count'] &gt; 1">albums</t><t t-else="">album</t>)</em>
                                    </td>
                                    <td class="text-end">
                                        <em t-out="serie['prix_achat']"
                                            t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="text-end">
                                        <em t-out="serie['valeur_estimee']"
                                            t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="o_comic_inventory_total">
                                <td colspan="5" class="text-end">
                                    <strong>Grand total
                                        (<t t-out="inventory['count']"/> <t t-if="inventory['count'] &gt; 1">albums</t><t t-else="">album</t>)</strong>
                                </td>
                                <td class="text-end">
                                    <strong t-out="inventory['prix_achat']"
                                            t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <strong t-out="inventory['valeur_estimee']"
                                            t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                    <p>Number of albums: <strong t-out="inventory['count']"/></p>
                </div>
            </t>
        </t>
    </template>

</odoo>
