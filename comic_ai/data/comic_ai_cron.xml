<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- US-090 : synopsis vides remplis par l'IA en tâche de fond.
         Désactivé par défaut : chaque synopsis est un appel payant au fournisseur. -->
    <record id="ir_cron_fill_empty_synopses" model="ir.cron">
        <field name="name">BD — IA : textes vides (synopsis, biographies, éditeurs)</field>
        <field name="model_id" ref="comic_ai.model_comic_ai_service"/>
        <field name="state">code</field>
        <field name="code">model._cron_fill_empty_synopses()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>

</odoo>
