<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- US-029 : découverte IA par profil de goûts -->
    <record id="view_comic_ai_discovery_wizard_form" model="ir.ui.view">
        <field name="name">comic.ai.discovery.wizard.form</field>
        <field name="model">comic.ai.discovery.wizard</field>
        <field name="arch" type="xml">
            <form string="Découvrir de nouvelles BD">
                <field name="state" invisible="1"/>

                <!-- Étape 1 : profil -->
                <div invisible="state != 'profile'">
                    <div class="alert alert-info" role="status">
                        L'IA propose 10 à 15 séries proches de vos préférées, en excluant celles
                        déjà dans votre collection ou votre wishlist. Le profil reprend les séries
                        dont vous avez noté au moins un album 4★ ou plus : retirez ou ajoutez des
                        séries avant de lancer la recherche.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="profile_serie_ids">
                        Votre profil est vide : notez au moins une BD 4★ dans votre bibliothèque,
                        ou ajoutez ici des séries que vous aimez.
                    </div>
                    <field name="profile_serie_ids" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="genre_id"/>
                            <field name="editeur_id" optional="show"/>
                        </list>
                    </field>
                </div>

                <!-- Étape 2 : suggestions -->
                <div invisible="state != 'suggestions'">
                    <div class="alert alert-info" role="status">
                        Cochez les séries qui vous tentent puis cliquez sur « Ajouter à ma wishlist »
                        (le premier tome est ajouté). « Vérifier » interroge les sources de données
                        pour s'assurer que la série existe bien.
                        <span invisible="not nb_ignored">
                            <field name="nb_ignored" class="d-inline"/> suggestion(s) écartée(s) :
                            déjà en collection, en wishlist ou en double.
                        </span>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="line_ids">
                        Aucune nouvelle série à proposer : toutes les suggestions de l'IA sont déjà
                        connues. Relancez ou modifiez votre profil.
                    </div>
                    <field name="line_ids" nolabel="1" invisible="not line_ids">
                        <list editable="bottom" create="0" delete="0"
                              decoration-muted="added"
                              decoration-danger="verify_state == 'not_found'">
                            <field name="selected" widget="boolean_toggle" readonly="added"/>
                            <field name="name" readonly="1"/>
                            <field name="auteurs" readonly="1"/>
                            <field name="genre" readonly="1" optional="show"/>
                            <field name="raison" readonly="1"/>
                            <field name="serie_id" readonly="1" optional="hide"/>
                            <field name="verify_state" widget="badge" readonly="1"
                                   decoration-success="verify_state == 'found'"
                                   decoration-danger="verify_state == 'not_found'"
                                   decoration-warning="verify_state == 'error'"/>
                            <field name="verify_info" readonly="1" optional="show"/>
                            <button name="action_verify" type="object" icon="fa-search"
                                    string="Vérifier" title="Vérifier sur les sources"
                                    invisible="added"/>
                            <field name="added" widget="boolean" readonly="1"/>
                        </list>
                    </field>
                </div>

                <footer>
                    <button name="action_generate" string="Obtenir des suggestions" type="object"
                            class="btn-primary" icon="fa-magic" invisible="state != 'profile'"/>
                    <button name="action_add_to_wishlist" string="Ajouter à ma wishlist" type="object"
                            class="btn-primary" icon="fa-heart" invisible="state != 'suggestions' or not line_ids"/>
                    <button name="action_generate" string="Relancer" type="object"
                            class="btn-secondary" invisible="state != 'suggestions'"/>
                    <button name="action_back" string="Modifier le profil" type="object"
                            class="btn-secondary" invisible="state != 'suggestions'"/>
                    <button string="Fermer" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_comic_ai_discovery_wizard" model="ir.actions.act_window">
        <field name="name">Découvrir de nouvelles BD</field>
        <field name="res_model">comic.ai.discovery.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_comic_ai_discovery"
              name="Découvrir de nouvelles BD"
              parent="comics_collections.menu_comic_collection"
              action="action_comic_ai_discovery_wizard"
              groups="comics_collections.group_comic_user"
              sequence="23"/>

</odoo>
