<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- US-027 / US-028 : assistant IA (synopsis, traduction) avec prévisualisation -->
    <record id="view_comic_ai_wizard_form" model="ir.ui.view">
        <field name="name">comic.ai.wizard.form</field>
        <field name="model">comic.ai.wizard</field>
        <field name="arch" type="xml">
            <form string="Assistant IA">
                <field name="state" invisible="1"/>
                <field name="destination_has_synopsis" invisible="1"/>
                <field name="target_edition_id" invisible="1"/>
                <field name="provider" invisible="1"/>
                <group>
                    <group>
                        <field name="serie_id" readonly="1" invisible="not serie_id"/>
                        <field name="partner_id" readonly="1" invisible="not partner_id"/>
                        <field name="editeur_id" readonly="1" invisible="not editeur_id"/>
                        <field name="work_id" readonly="1" invisible="not edition_id"/>
                        <field name="edition_id" readonly="1" invisible="not edition_id"/>
                        <field name="mode" widget="radio"/>
                    </group>
                    <group>
                        <field name="lang" invisible="mode != 'synopsis'"/>
                        <field name="target_lang" invisible="mode != 'translate'"
                               required="mode == 'translate'"/>
                        <field name="translate_destination" widget="radio"
                               invisible="mode != 'translate' or not target_edition_id"/>
                        <field name="destination_edition_id" readonly="1"
                               invisible="mode != 'translate' or not target_edition_id"/>
                    </group>
                </group>

                <div class="alert alert-warning" role="alert"
                     invisible="mode != 'translate' or source_synopsis">
                    Cette fiche n'a pas encore de synopsis à traduire : générez-en un d'abord.
                </div>

                <!-- Prévisualisation : ancien / nouveau -->
                <div invisible="state != 'preview'">
                    <div class="row">
                        <div class="col-12 col-md" invisible="not destination_has_synopsis">
                            <h5>Texte existant</h5>
                            <field name="destination_synopsis" readonly="1" nolabel="1"/>
                        </div>
                        <div class="col-12 col-md">
                            <h5>Nouveau texte</h5>
                            <field name="generated_text" nolabel="1" class="w-100"/>
                        </div>
                    </div>
                    <div class="text-muted small mt-1">
                        Généré avec <field name="model_name" class="d-inline" readonly="1"/> —
                        vous pouvez retoucher le texte avant de l'appliquer.
                    </div>
                    <div class="mt-3" invisible="not destination_has_synopsis">
                        <field name="replace_confirmed"/>
                        <label for="replace_confirmed"/>
                    </div>
                </div>

                <!-- Champ lu par la condition d'avertissement ci-dessus -->
                <field name="source_synopsis" invisible="1"/>

                <p class="text-muted small mt-3 mb-0">
                    <i class="fa fa-clock-o me-1"/>La génération peut prendre quelques secondes.
                </p>

                <footer>
                    <button name="action_generate" type="object" string="Générer"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_apply" type="object" string="Appliquer"
                            class="btn-primary" invisible="state != 'preview'"/>
                    <button name="action_generate" type="object" string="Régénérer"
                            class="btn-secondary" invisible="state != 'preview'"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
