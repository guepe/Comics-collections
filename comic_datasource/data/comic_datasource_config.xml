<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Valeurs par défaut des paramètres de configuration -->
    <record id="param_openlibrary_enabled" model="ir.config_parameter">
        <field name="key">comic.openlibrary_enabled</field>
        <field name="value">True</field>
    </record>
    <record id="param_bnf_enabled" model="ir.config_parameter">
        <field name="key">comic.bnf_enabled</field>
        <field name="value">True</field>
    </record>
    <record id="param_datasource_order" model="ir.config_parameter">
        <field name="key">comic.datasource_order</field>
        <field name="value">["google", "openlibrary", "bnf"]</field>
    </record>
</odoo>
