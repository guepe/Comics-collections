<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_check_missing_volumes" model="ir.cron">
        <field name="name">Comics — Weekly missing volumes detection</field>
        <field name="model_id" ref="comics_collections.model_comic_serie"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_missing_volumes()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="False"/>
    </record>

    <record id="ir_cron_update_editions" model="ir.cron">
        <field name="name">Comics — Daily enrichment of incomplete editions</field>
        <field name="model_id" ref="comics_collections.model_comic_edition"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_editions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
    </record>

</odoo>
