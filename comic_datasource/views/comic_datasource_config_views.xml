<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_comic_datasource" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.comic_datasource</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">

                <app data-string="Comic Books"
                     string="Comic Books"
                     name="comic_datasource"
                     groups="comics_collections.group_comic_manager">

                    <!-- Google Books API -->
                    <block title="Data Sources" id="comic_datasource_sources">

                        <setting id="comic_google_books_setting"
                                 title="Main source: synopses, HD covers and general metadata.">
                            <div class="row">
                                <div class="col-lg-8">
                                    <label for="comic_google_books_api_key" class="o_form_label fw-bold"/>
                                    <div class="text-muted mt-1">
                                        Free key on
                                        <a href="https://console.cloud.google.com" target="_blank">console.cloud.google.com</a>.
                                        Without a key: ~100 req/day (anonymous mode).
                                    </div>
                                    <div class="mt-2">
                                        <field name="comic_google_books_api_key"
                                               placeholder="AIza... (optional)"
                                               class="o_field_widget"/>
                                    </div>
                                    <div class="mt-2">
                                        <button name="action_test_google_books"
                                                string="Test the Google Books connection"
                                                type="object"
                                                class="btn btn-secondary btn-sm"/>
                                    </div>
                                </div>
                            </div>
                        </setting>

                        <!-- Open Library (le libellé de la case est affiché par <setting> : pas de <label>, #10) -->
                        <setting id="comic_openlibrary_setting"
                                 title="Alternative covers and metadata. Free, no API key required.">
                            <field name="comic_openlibrary_enabled"/>
                            <div class="text-muted mt-1">
                                Open Library provides covers and metadata for millions
                                of books. Enabled by default.
                            </div>
                        </setting>

                        <!-- BnF -->
                        <setting id="comic_bnf_setting"
                                 title="Official legal deposit data. Free, no API key required.">
                            <field name="comic_bnf_enabled"/>
                            <div class="text-muted mt-1">
                                The BnF (Bibliothèque nationale de France) indexes all comics
                                submitted to legal deposit in France. Takes priority for
                                <code>date_depot_legal</code>. Enabled by default.
                            </div>
                        </setting>

                    </block>
                </app>

            </xpath>
        </field>
    </record>

</odoo>
