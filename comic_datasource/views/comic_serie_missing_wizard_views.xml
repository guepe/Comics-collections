<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue du wizard de détection des tomes manquants -->
    <record id="view_comic_serie_missing_wizard_form" model="ir.ui.view">
        <field name="name">comic.serie.missing.wizard.form</field>
        <field name="model">comic.serie.missing.wizard</field>
        <field name="arch" type="xml">
            <form string="Missing Volumes">

                <!-- Confirmation -->
                <group invisible="state != 'confirm'">
                    <group string="Series to analyse">
                        <field name="serie_id" readonly="1"/>
                        <field name="nb_existing" readonly="1" string="Albums already in the database"/>
                    </group>
                    <group>
                        <div class="alert alert-info" role="status">
                            This action queries Google Books and the BnF to find the volumes
                            of the series that are not yet in your database.
                            The number of expected volumes is the series' "Number of volumes
                            released" if set, otherwise the highest known volume number.
                            <span invisible="not has_customer_library">
                                The detected volumes can be added to your wishlist.
                            </span>
                            <span invisible="has_customer_library">
                                The detected volumes can be added to the catalog.
                            </span>
                        </div>
                    </group>
                </group>

                <!-- Résultats -->
                <group invisible="state != 'results'">
                    <div invisible="nb_missing != 0" class="alert alert-warning" role="status">
                        No missing volume detected for this series.
                        Google Books and the BnF may not have all the volumes.
                    </div>
                    <div class="alert alert-info" role="status" invisible="nb_missing == 0">
                        Volumes detected via Google Books and the BnF. "Expected" lines are
                        volumes the series should contain (based on the number of volumes released
                        or the highest known volume) but that the sources did not return —
                        you can deselect them. Volume 0 (special issue) is never
                        considered missing.
                    </div>
                    <field name="nb_expected" readonly="1"/>
                    <field name="nb_missing" invisible="1"/>
                    <field name="line_ids" nolabel="1" invisible="nb_missing == 0">
                        <list editable="bottom"
                              decoration-muted="source == 'expected'"
                              decoration-warning="isbn_unverified">
                            <field name="selected" widget="boolean_toggle"/>
                            <field name="cover_data" widget="image"
                                   options="{'size': [50, 70]}" optional="show"/>
                            <field name="tome"/>
                            <field name="name"/>
                            <field name="isbn" optional="show"/>
                            <field name="isbn_unverified" string="⚠️" widget="boolean"
                                   optional="show"/>
                            <field name="date_parution" optional="show"/>
                            <field name="source" widget="badge"
                                   decoration-success="source == 'google'"
                                   decoration-primary="source == 'bnf'"
                                   decoration-warning="source == 'expected'"
                                   optional="show"/>
                        </list>
                    </field>
                </group>

                <!-- Rapport -->
                <group invisible="state != 'done'" string="Report">
                    <field name="import_report" nolabel="1" widget="html" readonly="1"/>
                </group>

                <!-- Champs cachés -->
                <field name="state" invisible="1"/>
                <field name="has_customer_library" invisible="1"/>

                <footer>
                    <!-- État : confirmation -->
                    <button name="action_search"
                            string="Search for missing volumes"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'confirm'"/>

                    <!-- État : résultats -->
                    <button name="action_add_to_wishlist"
                            string="Add to wishlist"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'results' or not has_customer_library"/>
                    <button name="action_add_to_catalogue"
                            string="Add to catalog"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'results' or has_customer_library"/>
                    <button name="action_back"
                            string="Back"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'results'"/>

                    <!-- État : terminé -->
                    <button name="action_close_and_return"
                            string="Back to series"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'done'"/>

                    <button name="action_close_and_return"
                            string="Close"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'done'"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
