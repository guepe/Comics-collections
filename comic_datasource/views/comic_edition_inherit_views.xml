<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bouton "Rechercher sur les sources BD" dans le formulaire édition -->
    <record id="view_comic_edition_form_inherit_datasource" model="ir.ui.view">
        <field name="name">comic.edition.form.inherit.datasource</field>
        <field name="model">comic.edition</field>
        <field name="inherit_id" ref="comics_collections.view_comic_edition_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/field[@name='image_couverture']" position="before">
                <div name="button_box" class="oe_button_box">
                    <button name="action_complete_from_sources"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-cloud-download"
                            title="Fills in empty fields (cover, synopsis, pages, ISBN, authors…) from Google Books, Open Library and the BnF">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Complete</span>
                            <span class="o_stat_text">info</span>
                        </div>
                    </button>
                    <button name="action_search_datasource"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-search">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Search</span>
                            <span class="o_stat_text">the sources</span>
                        </div>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Fiche album : « Compléter les infos » sur l'édition principale -->
    <record id="view_comic_work_form_inherit_datasource" model="ir.ui.view">
        <field name="name">comic.work.form.inherit.datasource</field>
        <field name="model">comic.work</field>
        <field name="inherit_id" ref="comics_collections.view_comic_work_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_complete_from_sources"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cloud-download"
                        invisible="not primary_edition_id"
                        title="Fills in empty fields (cover, synopsis, pages, ISBN, authors…) from Google Books, Open Library and the BnF">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Complete</span>
                        <span class="o_stat_text">info</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
