<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Vue liste des lignes de résultats ─────────────────────────────── -->
    <record id="view_comic_datasource_result_line_list" model="ir.ui.view">
        <field name="name">comic.datasource.result.line.list</field>
        <field name="model">comic.datasource.result.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-warning="is_duplicate">
                <field name="selected" widget="boolean_toggle"/>
                <field name="cover_data" widget="image" options="{'size': [60, 80]}" optional="show"/>
                <field name="title"/>
                <field name="serie_name" optional="show"/>
                <field name="tome" optional="show"/>
                <field name="isbn" optional="show"/>
                <field name="editeur" optional="show"/>
                <field name="auteurs_display" optional="show"/>
                <field name="date_parution" optional="show"/>
                <field name="source" widget="badge"
                       decoration-success="source == 'google'"
                       decoration-info="source == 'openlibrary'"
                       decoration-primary="source == 'bnf'"/>
                <field name="is_duplicate" widget="boolean"
                       column_invisible="True"/>
                <field name="existing_edition_id" optional="show"
                       invisible="not is_duplicate"/>
            </list>
        </field>
    </record>

    <!-- ── Wizard principal ──────────────────────────────────────────────── -->
    <record id="view_comic_datasource_search_wizard_form" model="ir.ui.view">
        <field name="name">comic.datasource.search.wizard.form</field>
        <field name="model">comic.datasource.search.wizard</field>
        <field name="arch" type="xml">
            <form string="Multi-source comic search">

                <!-- État : recherche -->
                <group invisible="state != 'search'">
                    <group string="Search for an album">
                        <field name="search_term" widget="isbn_scan"
                               placeholder="ISBN (9782...) or album title"
                               autofocus="1"/>
                        <field name="search_type" readonly="1"/>
                    </group>
                    <group>
                        <div class="text-muted">
                            Sources queried (in order of priority):
                            <b>Google Books</b> → <b>Open Library</b> → <b>BnF</b>
                        </div>
                    </group>
                </group>

                <!-- État : résultats -->
                <group invisible="state != 'results'" string="Results">
                    <div class="alert alert-info mb-2" role="status" invisible="not has_duplicates">
                        ⚠️ Some albums (highlighted in orange) have an ISBN already in the database.
                        Importing them will update the existing album.
                    </div>
                    <div class="alert alert-warning mb-2" role="status" invisible="not has_title_conflicts">
                        ⚠️ Some titles (highlighted in red) differ from the version in the database (e.g. English vs French title).
                        Choose the action to take on each line.
                    </div>
                    <field name="result_ids"
                           widget="one2many"
                           nolabel="1"
                           context="{'default_wizard_id': id}">
                        <list editable="bottom"
                              decoration-warning="is_duplicate and not title_conflict"
                              decoration-danger="title_conflict">
                            <field name="selected" widget="boolean_toggle"/>
                            <field name="cover_data" widget="image" options="{'size': [60, 80]}" optional="show"/>
                            <field name="title"/>
                            <field name="existing_title" string="Title in database"
                                   optional="show" readonly="1"
                                   invisible="not title_conflict"/>
                            <field name="title_action" string="Title action"
                                   optional="show"
                                   invisible="not title_conflict"/>
                            <field name="serie_name" optional="show"/>
                            <field name="tome" optional="show"/>
                            <field name="isbn" optional="show"/>
                            <field name="editeur" optional="show"/>
                            <field name="auteurs_display" string="Authors" optional="show"/>
                            <field name="date_parution" optional="show"/>
                            <field name="source" widget="badge"
                                   decoration-success="source == 'google'"
                                   decoration-info="source == 'openlibrary'"
                                   decoration-primary="source == 'bnf'"
                                   decoration-warning="source == 'bnf'"/>
                            <field name="is_duplicate" column_invisible="True"/>
                            <field name="title_conflict" column_invisible="True"/>
                            <field name="existing_edition_id" optional="show"
                                   invisible="not is_duplicate"/>
                        </list>
                    </field>
                </group>

                <!-- État : terminé -->
                <group invisible="state != 'done'" string="Import report">
                    <field name="import_report" nolabel="1" widget="html" readonly="1"/>
                </group>

                <!-- Champs cachés -->
                <field name="state" invisible="1"/>
                <field name="edition_id" invisible="1"/>
                <field name="has_duplicates" invisible="1"/>
                <field name="has_title_conflicts" invisible="1"/>

                <footer>
                    <!-- Boutons état : recherche -->
                    <button name="action_search"
                            string="Search"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'search'"/>

                    <!-- Boutons état : résultats -->
                    <button name="action_import"
                            string="Import selection"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'results'"/>
                    <button name="action_back"
                            string="Back"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'results'"/>

                    <!-- Boutons état : terminé -->
                    <button name="action_view_imported"
                            string="View albums"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'done'"/>
                    <button name="action_new_search"
                            string="New search"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'done'"/>

                    <button name="action_close_and_return"
                            string="Close"
                            type="object"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── Action pour ouvrir le wizard depuis le menu ───────────────────── -->
    <record id="action_comic_datasource_search_wizard" model="ir.actions.act_window">
        <field name="name">Search and Import Comics</field>
        <field name="res_model">comic.datasource.search.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="comics_collections.model_comic_edition"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- ── Action standalone (menu + bouton formulaire) ─────────────────── -->
    <record id="action_comic_datasource_search_wizard_standalone" model="ir.actions.act_window">
        <field name="name">Search Comics</field>
        <field name="res_model">comic.datasource.search.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
