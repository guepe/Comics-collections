<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bouton "Mettre à jour depuis les sources" dans le formulaire série -->
    <record id="view_comic_serie_form_inherit_datasource" model="ir.ui.view">
        <field name="name">comic.serie.form.inherit.datasource</field>
        <field name="model">comic.serie</field>
        <field name="inherit_id" ref="comics_collections.view_comic_serie_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_update_albums_from_datasource"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-refresh">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Update</span>
                            <span class="o_stat_text">albums</span>
                        </div>
                    </button>
                    <button name="action_search_missing_volumes"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-search">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Missing</span>
                            <span class="o_stat_text">volumes</span>
                        </div>
                    </button>
            </xpath>
            <xpath expr="//group/field[@name='nb_works_total']" position="after">
                <field name="nb_tomes_parus"/>
                <field name="missing_last_check" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Vue du wizard de mise à jour série -->
    <record id="view_comic_serie_update_wizard_form" model="ir.ui.view">
        <field name="name">comic.serie.update.wizard.form</field>
        <field name="model">comic.serie.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Update from data sources">

                <!-- Confirmation -->
                <group invisible="state != 'confirm'">
                    <group string="Series to update">
                        <field name="serie_id" readonly="1"/>
                        <field name="nb_albums" readonly="1" string="Albums in the series"/>
                    </group>
                    <group>
                        <div class="alert alert-info" role="status">
                            This action will query the data sources (Google Books, Open Library, BnF)
                            for each album in the series and update:
                            cover, synopsis, number of pages, release date, missing authors.
                        </div>
                    </group>
                </group>

                <!-- Rapport -->
                <group invisible="state != 'done'" string="Update report">
                    <field name="import_report" nolabel="1" widget="html" readonly="1"/>
                </group>

                <!-- Champ caché -->
                <field name="state" invisible="1"/>

                <footer>
                    <button name="action_run"
                            string="Update albums"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'confirm'"/>
                    <button name="action_close_and_return"
                            string="Close"
                            type="object"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
