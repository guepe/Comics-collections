[flake8]
max-line-length = 120
extend-ignore = E203,W503
per-file-ignores =
    # Odoo pattern: __init__.py imports submodules to register them, not for direct use
    */__init__.py: F401
    # Odoo manifests are bare dict expressions by design
    */__manifest__.py: B018
    # XML content embedded in Python strings — lines cannot be broken
    comics_collections/wizards/comic_import_wizard.py: E501
