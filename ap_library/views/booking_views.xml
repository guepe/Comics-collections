<odoo>
    <record id="booking_history_list" model="ir.ui.view">
        <field name="name">booking.list</field>
        <field name="model">booking.history</field>
        <field name="arch" type="xml">
            <list
                decoration-success="status == 'approved'"
                decoration-danger="status == 'pending'"
                decoration-warning="status == 'draft'"
                decoration-info="status == 'returned'"
            >
                <field name="name"></field>
                <field name="booking_date"></field>
                <field name="expiry_date"></field>
                <field name="status"
                    widget="badge"
                    decoration-success="status == 'approved'"
                    decoration-warning="status == 'pending'"
                    decoration-danger="status == 'draft'"
                    decoration-muted="status == 'returned'" />

                <field name="issued_by"></field>
                <!-- <field name="received_by"></field> -->
                <field name="assign_to"></field>
                <field name="book_id"></field>
                <field name="total_days"></field>

            </list>
        </field>
    </record>


    <record id="view_library_booking_history_form" model="ir.ui.view">
        <field name="name">booking.form</field>
        <field name="model">booking.history</field>
        <field name="arch" type="xml">
            <form string="Booking history">
                <header invisible="context.get('hide_header')">

                    <button name="action_pending_booking"
                        type="object"
                        class="btn-success"
                        string="Request: Issue"
                        invisible="status != 'draft'"
                        groups="wk_library_management.group_library_user" />

                    <!-- <button name="action_approved_booking"
                        type="object"
                        class="btn-success"
                        string="Approve"
                        invisible="status not in ['pending', 'draft']"
                        groups="wk_library_management.group_library_librarian,wk_library_management.group_library_admin" /> -->

                    <button name="action_validate_approve"
                        type="object"
                        string="Validate &amp; Approve"
                        class="btn-primary"
                        invisible="status not in ['pending', 'draft']"
                        groups="wk_library_management.group_library_librarian,wk_library_management.group_library_admin" />

                    <button name="action_rejected_booking"
                        type="object"
                        class="btn-danger"
                        string="Reject"
                        invisible="status != 'pending'"
                        groups="wk_library_management.group_library_librarian,wk_library_management.group_library_admin" />

                    <button name="action_returned_booking"
                        type="object"
                        class="btn-info"
                        string="Return Book"
                        invisible="status != 'approved'"
                        groups="wk_library_management.group_library_librarian,wk_library_management.group_library_admin" />
                    <!-- <button name="%(wk_library_management.action_report_booking_history)d"
                        type="action"
                        string="Print Booking Report"
                        class="btn-primary"
                        invisible="not id" /> -->
                    <button name="action_print_booking_report"
                        type="object"
                        string="Print Booking Report"
                        class="btn-primary"
                        invisible="not id" />

                    <field name="status" widget="statusbar"></field>
                </header>
                <sheet class="px-5 py-2">

                    <div class="p-4">
                        <group>
                            <group>
                                <h1>
                                    <label for="name" />
                                    <field name="name" nolabel="1" />
                                </h1>
                            </group>


                            <group>

                                <field name="booking_date"
                                    readonly="status != 'draft'" />


                                <field name="expiry_date"
                                    readonly="status != 'draft'" />


                            </group>

                        </group>

                    </div>
                    <!-- <separator /> -->
                    <notebook>
                        <page string="Extra Informations">
                            <group>
                                <group>
                                    <label for="issued_by" />
                                    <field name="issued_by" nolabel="1"
                                        groups="wk_library_management.group_library_librarian,wk_library_management.group_library_admin"
                                        readonly="status in ['returned','rejected']" />
                                </group>
                                <!-- <group>
                                    <label for="received_by" />
                                    <field name="received_by" nolabel="1"
                                        groups="wk_library_management.group_library_librarian,wk_library_management.group_library_admin" />
                                </group> -->
                                <group>
                                    <label for="book_id" />
                                    <field name="book_id" nolabel="1"
                                        readonly="context.get('redonly_book') or status != 'draft'"
                                        force_save="1"
                                    />
                                </group>
                            </group>
                            <group>
                                <group>

                                    <label for="assign_to"></label>

                                    <!-- Admin editable -->
                                    <field name="assign_to"
                                        groups="wk_library_management.group_library_admin"
                                        nolabel="1" />

                                    <!-- User + Librarian readonly -->
                                    <field name="assign_to"
                                        groups="wk_library_management.group_library_librarian"
                                        readonly="id != False"
                                        nolabel="1" />

                                    <field name="assign_to"
                                        groups="wk_library_management.group_library_user"
                                        readonly="1"
                                        nolabel="1" />
                                </group>
                                <!-- <group>
                                    <label for="book_id" />
                                    <field name="book_id" nolabel="1"
                                        readonly="context.get('redonly_book') or status != 'draft'"
                                        force_save="1"
                                    />
                                </group> -->
                            </group>
                            <label for="total_days"
                                invisible="not booking_date or not expiry_date"
                                string="Total Days = " />

                            <field name="total_days"
                                readonly="1"
                                invisible="not booking_date or not expiry_date" />
                        </page>
                    </notebook>

                </sheet>

                <chatter />
            </form>

        </field>

    </record>

    <record id="booking_history_kanban" model="ir.ui.view">
        <field name="name">booking.history.kanban</field>
        <field name="model">booking.history</field>
        <field name="arch" type="xml">
            <kanban create="0" sample="1" class="o_kanban_mobile">
                <field name="status" />
                <field name="name" />
                <field name="assign_to" />
                <field name="book_id" />
                <field name="booking_date" />
                <field name="expiry_date" />
                <field name="total_days" />

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click border shadow-sm">
                            <div class="oe_kanban_details p-2">

                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <strong class="o_kanban_record_title"
                                        style="font-size: 1.1em; line-height: 1.2;">
                                        <field name="name" />
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="status" widget="label_selection"
                                            options="{'classes': {'draft': 'secondary', 'pending': 'warning', 'approved': 'success', 'returned': 'info'}}" />
                                    </div>
                                </div>

                                <div class="text-muted small">
                                    <div class="mb-1">
                                        <i class="fa fa-book text-primary mr-1" />
                                        <field name="book_id" />
                                    </div>
                                    <div>
                                        <i class="fa fa-calendar-o mr-1" />
                                        <field name="booking_date" />
                                        <span class="mx-1">→</span>
                                        <field name="expiry_date" />
                                    </div>
                                </div>

                                <div
                                    class="o_kanban_record_bottom mt-2 pt-1 border-top d-flex justify-content-between align-items-center">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="badge badge-pill badge-light border text-dark">
                                            <field name="total_days" /> Days </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="assign_to" widget="many2one_avatar_user" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_booking" model="ir.actions.act_window">
        <field name="name">History</field>
        <field name="res_model">booking.history</field>
        <field name="view_mode">list,form,kanban</field>

    </record>


</odoo>