<odoo>
    <record id="book_category_list" model="ir.ui.view">
        <field name="name">category.list</field>
        <field name="model">book.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"></field>
                <field name="description"></field>
                <field name="image" widget="image" options="{'size':[90,90]}"></field>

                <field name="parent_id"></field>
            </list>
        </field>
    </record>


    <record id="view_library_category_form" model="ir.ui.view">
        <field name="name">category.form</field>
        <field name="model">book.category</field>
        <field name="arch" type="xml">

            <form string="Category">
                <header>
                    <button name="action_view_books"
                        type="object"
                        class="oe_stat_button btn-success"
                    >

                        <div class="o_stat_info">

                            <span class="o_stat_text">
                                No of Books :
                            </span>
                            <span class="o_stat_value">
                                <field name="count_book" />
                            </span>
                        </div>

                    </button>
                </header>

                <sheet>


                    <group>
                        <group>
                            <div class="oe-title">
                                <group>
                                    <label for="name"></label>
                                    <field name="name" placeholder="Enter Book name..." nolabel="1"></field>
                                </group>
                            </div>
                        </group>
                        <group>
                            <field name="image" widget="image" class="oe-avatar"
                                options="{'size':[150,150]}"></field>
                        </group>
                    </group>
                    <group>
                        <label for="description"></label>

                        <field name="description" placeholder="Write descriptions..........."
                            nolabel="1"></field>
                    </group>
                    <seprator></seprator>
                    <notebook>
                        <page string="Advanced Fields">
                            <group>
                                <group>
                                    <label for="parent_id" />
                                    <field name="parent_id" nolabel="1"></field>
                                </group>

                                <group>
                                    <label for="book_ids" />
                                    <field name="book_ids" nolabel="1" widget="many2many_tags" />
                                </group>
                            </group>

                        </page>

                    </notebook>
                </sheet>

            </form>
        </field>

    </record>

    <record id="book_category_kanban" model="ir.ui.view">
        <field name="name">book.category.kanban</field>
        <field name="model">book.category</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">


                <field name="name" />
                <field name="description" />
                <field name="image" />
                <field name="parent_id" />

                <templates>
                    <t t-name="kanban-box">
                        <div class="d-flex align-items-center">

                            <div class="me-3">
                                <field name="image"
                                    widget="image"
                                    class="oe_avatar"
                                    options="{'size': [80, 80]}" />
                            </div>

                            <div class="oe_kanban_details mt8">


                                <strong>
                                    <field name="name" />
                                </strong>


                                <div class="text-muted mt4">
                                    <field name="description" />
                                </div>


                                <div class="mt4">
                                    <span class="text-primary">
                                        <field name="parent_id" />
                                    </span>
                                </div>

                            </div>
                        </div>
                    </t>
                </templates>

            </kanban>
        </field>
    </record>


    <record id="action_category" model="ir.actions.act_window">
        <field name="name">Category</field>
        <field name="res_model">book.category</field>
        <field name="view_mode">list,form,kanban</field>

    </record>


</odoo>