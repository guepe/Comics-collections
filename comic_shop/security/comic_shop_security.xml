<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_comic_shop" model="ir.module.category">
        <field name="name">Comic Shop</field>
        <field name="sequence">101</field>
    </record>

    <!-- Privilege (obligatoire Odoo 19) -->

    <record id="privilege_comic_shop" model="res.groups.privilege">
        <field name="name">Comic Shop</field>
        <field name="category_id" ref="module_category_comic_shop"/>
        <field name="placeholder">Aucun accès</field>
        <field name="sequence">100</field>
    </record>

    <!-- Groupe Shop Manager : implique le gestionnaire de collection -->

    <record id="group_shop_manager" model="res.groups">
        <field name="name">Gestionnaire Shop</field>
        <field name="privilege_id" ref="privilege_comic_shop"/>
        <field name="implied_ids" eval="[Command.link(ref('comics_collections.group_comic_manager'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>


    <!-- Record rules : comic.customer.album -->

    <record id="rule_customer_album_user" model="ir.rule">
        <field name="name">Bibliothèque client : utilisateur voit ses propres entrées</field>
        <field name="model_id" ref="model_comic_customer_album"/>
        <field name="groups" eval="[(4, ref('comics_collections.group_comic_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    </record>

    <record id="rule_customer_album_portal" model="ir.rule">
        <field name="name">Bibliothèque client : portail voit ses propres entrées</field>
        <field name="model_id" ref="model_comic_customer_album"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    </record>

    <record id="rule_customer_album_manager" model="ir.rule">
        <field name="name">Bibliothèque client : gestionnaire shop voit tout</field>
        <field name="model_id" ref="model_comic_customer_album"/>
        <field name="groups" eval="[(4, ref('comic_shop.group_shop_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
