<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- US-069 : email « disponible » envoyé aux clients à la mise en vente d'un album -->
    <record id="mail_template_comic_release_available" model="mail.template">
        <field name="name">BD : album disponible (clients qui suivent la série ou l'ont en wishlist)</field>
        <field name="model_id" ref="comics_collections.model_comic_edition"/>
        <field name="subject">Bonne nouvelle — {{ object.work_id.display_name }} est disponible !</field>
        <field name="email_from">{{ (user.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="margin: 0; padding: 0;">
    <p>Bonjour,</p>
    <p>
        <strong t-out="object.work_id.display_name or ''">Thorgal T42</strong>
        est désormais disponible dans notre boutique.
    </p>
    <p t-if="object.work_id.serie_id">
        Vous suivez la série <strong t-out="object.work_id.serie_id.name or ''">Thorgal</strong>,
        ou cet album est dans votre wishlist.
    </p>
    <p style="margin: 24px 0;">
        <a t-att-href="object._get_release_product_url()"
           style="background-color: #875A7B; padding: 8px 16px; color: #ffffff; text-decoration: none; border-radius: 4px;">
            Voir l'album
        </a>
    </p>
    <p style="font-size: 12px; color: #888888;">
        Vous ne souhaitez plus être prévenu pour une série ? Gérez vos séries suivies depuis
        <a t-att-href="object.product_tmpl_id.get_base_url() + '/my/library/series'">votre espace client</a>.
    </p>
</div>
        </field>
    </record>

</odoo>
