<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Catégorie produit Odoo pour les BD -->
        <record id="product_category_bd" model="product.category">
            <field name="name">Bandes Dessinées</field>
        </record>

        <!-- Liste de prix par défaut pour le shop BD -->
        <record id="pricelist_bd_default" model="product.pricelist">
            <field name="name">Tarif Bandes Dessinées</field>
            <field name="currency_id" ref="base.EUR"/>
            <field name="active">True</field>
        </record>

    </data>

    <!-- ── Menus website ─────────────────────────────────────────────────────
         noupdate="0" : mis à jour à chaque upgrade du module.
         Pour supprimer les anciens sous-menus "Catalogue BD" sur une instance
         existante, aller dans Site Web > Menus et les supprimer manuellement.
    ── -->
    <data noupdate="0">

        <record id="menu_bd_catalogue" model="website.menu">
            <field name="name">Ma Collection</field>
            <field name="url">/my/library</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">60</field>
        </record>

    </data>
</odoo>
