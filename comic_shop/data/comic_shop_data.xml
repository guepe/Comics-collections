<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Catégorie produit Odoo pour les BD -->
        <record id="product_category_bd" model="product.category">
            <field name="name">Bandes Dessinées</field>
        </record>

        <!-- Liste de prix par défaut pour le shop BD -->
        <record id="pricelist_bd_default" model="product.pricelist">
            <field name="name">Tarif Bandes Dessinées</field>
            <field name="currency_id" ref="base.EUR"/>
            <field name="active">True</field>
        </record>

        <!-- ── Menus website "Catalogue BD" ────────────────────────────────────
             noupdate="1" → respecte les modifications faites depuis le website builder.
             parent_id ref="website.main_menu" : entrée de niveau racine dans la navbar.
        ── -->

        <record id="menu_bd_catalogue" model="website.menu">
            <field name="name">Catalogue BD</field>
            <field name="url">/shop/series</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">60</field>
        </record>

        <record id="menu_bd_series" model="website.menu">
            <field name="name">Séries</field>
            <field name="url">/shop/series</field>
            <field name="parent_id" ref="comic_shop.menu_bd_catalogue"/>
            <field name="sequence">10</field>
        </record>

        <record id="menu_bd_auteurs" model="website.menu">
            <field name="name">Auteurs</field>
            <field name="url">/shop/auteurs</field>
            <field name="parent_id" ref="comic_shop.menu_bd_catalogue"/>
            <field name="sequence">20</field>
        </record>

        <record id="menu_bd_editeurs" model="website.menu">
            <field name="name">Maisons d'édition</field>
            <field name="url">/shop/editeurs</field>
            <field name="parent_id" ref="comic_shop.menu_bd_catalogue"/>
            <field name="sequence">30</field>
        </record>

    </data>
</odoo>
