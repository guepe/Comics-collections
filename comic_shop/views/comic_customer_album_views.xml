<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bibliothèque (modèle et vues de base dans comics_collections) : volet commercial -->

    <record id="view_comic_customer_album_list_inherit_shop" model="ir.ui.view">
        <field name="name">comic.customer.album.list.inherit.shop</field>
        <field name="model">comic.customer.album</field>
        <field name="inherit_id" ref="comics_collections.view_comic_customer_album_list"/>
        <field name="arch" type="xml">
            <field name="date_ajout" position="after">
                <field name="has_product" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_comic_customer_album_form_inherit_shop" model="ir.ui.view">
        <field name="name">comic.customer.album.form.inherit.shop</field>
        <field name="model">comic.customer.album</field>
        <field name="inherit_id" ref="comics_collections.view_comic_customer_album_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='commentaire']" position="after">
                <group string="Commercial" name="commercial" groups="comic_shop.group_shop_manager">
                    <field name="has_product" readonly="1"/>
                    <field name="sale_order_line_id" readonly="1"/>
                    <field name="pos_order_line_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_comic_customer_album_search_inherit_shop" model="ir.ui.view">
        <field name="name">comic.customer.album.search.inherit.shop</field>
        <field name="model">comic.customer.album</field>
        <field name="inherit_id" ref="comics_collections.view_comic_customer_album_search"/>
        <field name="arch" type="xml">
            <filter name="wishlist" position="after">
                <filter string="Acheté ici" name="achete_ici"
                        domain="[('source', '=', 'achete_ici')]"/>
                <filter string="Sans produit shop" name="sans_produit"
                        domain="[('has_product', '=', False)]"/>
            </filter>
        </field>
    </record>

    <!-- Action fenêtre -->

    <record id="action_comic_customer_album" model="ir.actions.act_window">
        <field name="name">Bibliothèques clients</field>
        <field name="res_model">comic.customer.album</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="comics_collections.view_comic_customer_album_search"/>
        <field name="context">{'search_default_by_partner': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune bibliothèque client pour l'instant.
            </p>
        </field>
    </record>

    <!-- Menus Comic Shop -->

    <menuitem id="menu_comic_shop_root"
              name="Comic Shop"
              groups="comic_shop.group_shop_manager"
              sequence="11"/>

    <menuitem id="menu_comic_shop_customers"
              name="Bibliothèques clients"
              parent="menu_comic_shop_root"
              action="action_comic_customer_album"
              sequence="10"/>

    <menuitem id="menu_comic_shop_a_valider"
              name="À valider (portail)"
              parent="menu_comic_shop_root"
              action="action_comic_work_a_valider"
              groups="comic_shop.group_shop_manager"
              sequence="20"/>

</odoo>
