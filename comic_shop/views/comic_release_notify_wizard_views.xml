<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_comic_release_notify_wizard_form" model="ir.ui.view">
        <field name="name">comic.release.notify.wizard.form</field>
        <field name="model">comic.release.notify.wizard</field>
        <field name="arch" type="xml">
            <form string="Prévenir les clients">
                <div class="alert alert-info" role="alert">
                    <strong><field name="recipient_count" class="d-inline"/> client(s)</strong>
                    seront prévenus par email : ils suivent la série ou ont l'album en
                    wishlist, et ne l'ont pas encore reçu pour cet album.
                </div>
                <field name="summary_html" nolabel="1"/>
                <notebook>
                    <page string="Aperçu de l'email" name="preview">
                        <group>
                            <field name="preview_subject"/>
                        </group>
                        <field name="preview_body" nolabel="1"/>
                    </page>
                    <page string="Destinataires" name="recipients">
                        <field name="recipient_partner_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="email"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <field name="edition_ids" invisible="1"/>
                <footer>
                    <button name="action_send" type="object" string="Envoyer" class="btn-primary"
                            invisible="not recipient_count"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
