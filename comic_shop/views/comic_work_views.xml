<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Catalogue partagé : filtres pour retrouver SA bibliothèque parmi tous les albums -->
    <record id="view_comic_work_search_inherit_shop" model="ir.ui.view">
        <field name="name">comic.work.search.inherit.shop</field>
        <field name="model">comic.work</field>
        <field name="inherit_id" ref="comics_collections.view_comic_work_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='sans_couverture']" position="before">
                <filter string="Ma collection" name="ma_collection"
                        domain="[('edition_ids.customer_album_ids', 'any', [('partner_id.user_ids', 'in', [uid]), ('dans_collection', '=', True)])]"/>
                <filter string="Ma wishlist" name="ma_wishlist"
                        domain="[('edition_ids.customer_album_ids', 'any', [('partner_id.user_ids', 'in', [uid]), ('dans_wishlist', '=', True)])]"/>
                <separator/>
                <filter string="À valider" name="a_valider_portail"
                        domain="[('a_valider', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <!-- Modération des albums proposés depuis le portail -->
    <record id="view_comic_work_form_inherit_shop_moderation" model="ir.ui.view">
        <field name="name">comic.work.form.inherit.shop.moderation</field>
        <field name="model">comic.work</field>
        <field name="inherit_id" ref="comics_collections.view_comic_work_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_valider_portail"
                            type="object"
                            string="Valider"
                            class="btn-primary"
                            invisible="not a_valider"
                            groups="comic_shop.group_shop_manager"/>
                </header>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <field name="a_valider" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="not a_valider">
                    Album proposé par un client depuis le portail
                    (<field name="portal_partner_id" class="oe_inline" readonly="1"/>) :
                    à vérifier avant mise en vente.
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_comic_work_a_valider" model="ir.actions.act_window">
        <field name="name">Albums à valider (portail)</field>
        <field name="res_model">comic.work</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="comics_collections.view_comic_work_search"/>
        <field name="domain">[('a_valider', '=', True)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun album proposé par un client n'attend de validation.
            </p>
        </field>
    </record>

</odoo>
