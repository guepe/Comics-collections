<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Catalogue partagé : filtres pour retrouver SA bibliothèque parmi tous les albums -->
    <record id="view_comic_work_search_inherit_shop" model="ir.ui.view">
        <field name="name">comic.work.search.inherit.shop</field>
        <field name="model">comic.work</field>
        <field name="inherit_id" ref="comics_collections.view_comic_work_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='sans_couverture']" position="before">
                <filter string="À valider" name="a_valider_portail"
                        domain="[('a_valider', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <!-- Modération des albums proposés depuis le portail -->
    <record id="view_comic_work_form_inherit_shop_moderation" model="ir.ui.view">
        <field name="name">comic.work.form.inherit.shop.moderation</field>
        <field name="model">comic.work</field>
        <field name="inherit_id" ref="comics_collections.view_comic_work_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_valider_portail"
                            type="object"
                            string="Valider"
                            class="btn-primary"
                            invisible="not a_valider"
                            groups="comic_shop.group_shop_manager"/>
                    <button name="%(comic_shop.action_comic_portal_refuse_wizard)d"
                            type="action"
                            string="Refuser"
                            invisible="not a_valider"
                            context="{'default_work_id': id}"
                            groups="comic_shop.group_shop_manager"/>
                </header>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <field name="a_valider" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="not a_valider">
                    Album proposé par un client depuis le portail
                    (<field name="portal_partner_id" class="oe_inline" readonly="1"/>) :
                    à vérifier avant mise en vente.
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_comic_work_list_a_valider" model="ir.ui.view">
        <field name="name">comic.work.list.a_valider</field>
        <field name="model">comic.work</field>
        <field name="arch" type="xml">
            <list string="Albums à valider" create="false">
                <field name="image_couverture" string=" " widget="image" options="{'size': [32, 48]}" width="44px"/>
                <field name="serie_id"/>
                <field name="tome" string="T°"/>
                <field name="titre_canonique" string="Titre"/>
                <field name="portal_partner_id"/>
                <field name="create_date" string="Proposé le"/>
                <field name="a_valider" column_invisible="1"/>
                <button name="action_valider_portail" type="object" string="Valider" icon="fa-check"
                        class="btn-link text-success"/>
                <button name="%(comic_shop.action_comic_portal_refuse_wizard)d" type="action" string="Refuser"
                        icon="fa-times" class="btn-link text-danger" context="{'default_work_id': id}"/>
            </list>
        </field>
    </record>

    <record id="action_comic_work_a_valider" model="ir.actions.act_window">
        <field name="name">Albums à valider (portail)</field>
        <field name="res_model">comic.work</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_comic_work_list_a_valider"/>
        <field name="search_view_id" ref="comics_collections.view_comic_work_search"/>
        <field name="domain">[('a_valider', '=', True)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun album proposé par un client n'attend de validation.
            </p>
        </field>
    </record>

    <!-- Couche « toutes les BD » apportée par le shop : le catalogue complet, ouvert à tous les
         utilisateurs BD (le cœur, en collection privée, le réserve au gestionnaire). -->
    <menuitem id="menu_comic_shop_catalogue_albums"
              name="Tous les albums"
              parent="comics_collections.menu_comic_catalogues"
              action="comics_collections.action_comic_work_catalogue"
              groups="comics_collections.group_comic_user"
              sequence="5"/>

    <menuitem id="menu_comic_shop_catalogue_series"
              name="Toutes les séries"
              parent="comics_collections.menu_comic_catalogues"
              action="comics_collections.action_comic_serie_catalogue"
              groups="comics_collections.group_comic_user"
              sequence="6"/>

</odoo>
