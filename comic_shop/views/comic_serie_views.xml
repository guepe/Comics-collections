<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Héritage du formulaire série pour ajouter les boutons shop -->

    <record id="view_comic_serie_form_shop" model="ir.ui.view">
        <field name="name">comic.serie.form.shop</field>
        <field name="model">comic.serie</field>
        <field name="inherit_id" ref="comics_collections.view_comic_serie_form"/>
        <field name="arch" type="xml">

            <!-- Injection dans le button_box déclaré par la vue de base -->
            <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_products"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-shopping-cart"
                            invisible="nb_albums_with_product == 0">
                        <field name="nb_albums_with_product" widget="statinfo"
                               string="Produit(s)"/>
                    </button>
                    <button name="action_create_products_from_isbn"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-upload"
                            invisible="nb_albums_isbn_sans_produit == 0"
                            confirm="Créer automatiquement un produit pour chaque album de cette série ayant un ISBN ?">
                        <field name="nb_albums_isbn_sans_produit" widget="statinfo"
                               string="À publier"/>
                    </button>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <field name="nb_albums_with_product" invisible="1"/>
                <field name="nb_albums_isbn_sans_produit" invisible="1"/>
                <field name="a_valider" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="not a_valider">
                    Série proposée par un client depuis le portail
                    (<field name="portal_partner_id" class="oe_inline" readonly="1"/>) :
                    à vérifier avant mise en vente.
                </div>
            </xpath>

            <!-- Modération des séries proposées depuis le portail -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_valider_portail"
                            type="object"
                            string="Valider"
                            class="btn-primary"
                            invisible="not a_valider"
                            groups="comic_shop.group_shop_manager"/>
                </header>
            </xpath>


        </field>
    </record>

    <record id="view_comic_serie_search_inherit_shop" model="ir.ui.view">
        <field name="name">comic.serie.search.inherit.shop</field>
        <field name="model">comic.serie</field>
        <field name="inherit_id" ref="comics_collections.view_comic_serie_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='bd']" position="before">
                <filter string="À valider" name="a_valider_portail"
                        domain="[('a_valider', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

</odoo>
