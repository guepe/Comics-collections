<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Héritage de la page produit website_sale pour les éditions BD.
        Toute injection est conditionnelle à l'existence de comic_edition
        (fourni par ComicShopController.product()), donc sans impact
        sur les produits non-BD.
    -->

    <template id="product_bd_title_badges" inherit_id="website_sale.product_title" name="BD — Badges page produit">

        <!-- Fil d'Ariane + badges BD sous le titre produit -->
        <xpath expr="//h1" position="after">
            <t t-if="comic_edition">
                <!-- Breadcrumb : Boutique > Série > Tome -->
                <t t-if="comic_edition.work_id.serie_id">
                    <nav aria-label="breadcrumb" class="mb-1 mt-2">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item"><a href="/shop">Boutique</a></li>
                            <li class="breadcrumb-item">
                                <a t-attf-href="/shop/series/{{ comic_edition.work_id.serie_id.id }}">
                                    <t t-esc="comic_edition.work_id.serie_id.name"/>
                                </a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                Tome <t t-esc="comic_edition.work_id.tome"/>
                            </li>
                        </ol>
                    </nav>
                </t>
                <div class="mb-2 d-flex flex-wrap gap-2">
                    <!-- Badge série/tome -->
                    <t t-if="comic_edition.work_id.serie_id and comic_edition.work_id.tome">
                        <span class="badge bg-primary fs-6">
                            Tome <t t-esc="comic_edition.work_id.tome"/> —
                            <t t-esc="comic_edition.work_id.serie_id.name"/>
                        </span>
                    </t>
                    <!-- Badge bibliothèque -->
                    <t t-if="comic_in_library">
                        <span class="badge bg-success fs-6">
                            <i class="fa fa-book me-1"/>Dans votre bibliothèque
                        </span>
                    </t>
                </div>
            </t>
        </xpath>

    </template>

    <template id="product_bd_enrich" inherit_id="website_sale.product" name="BD — Enrichissement page produit">

        <!-- Fiche BD détaillée — dans la colonne détails produit -->
        <xpath expr="//div[@id='product_details']" position="inside">
            <t t-if="comic_edition">
                <section class="o_comic_bd_details o_wsale_product_details_content_section mt-3 mb-4">
                    <h4 class="mb-3">Informations sur l'édition</h4>
                    <div class="row g-2">
                        <t t-if="comic_edition.work_id.serie_id">
                            <div class="col-md-6">
                                <strong>Série :</strong>
                                <a t-attf-href="/shop/series/{{ comic_edition.work_id.serie_id.id }}"
                                   t-esc="comic_edition.work_id.serie_id.name"/>
                            </div>
                        </t>
                        <t t-if="comic_edition.work_id.tome">
                            <div class="col-md-6">
                                <strong>Tome :</strong>
                                <span t-esc="comic_edition.work_id.tome"/>
                            </div>
                        </t>
                        <t t-if="comic_isbn">
                            <div class="col-md-6">
                                <strong>ISBN :</strong>
                                <span t-esc="comic_isbn"/>
                            </div>
                        </t>
                        <t t-if="comic_edition.date_parution">
                            <div class="col-md-6">
                                <strong>Parution :</strong>
                                <span t-esc="comic_edition.date_parution"/>
                            </div>
                        </t>
                        <t t-if="comic_edition.nb_pages">
                            <div class="col-md-6">
                                <strong>Pages :</strong>
                                <span t-esc="comic_edition.nb_pages"/>
                            </div>
                        </t>
                        <t t-if="comic_edition.work_id.serie_id.editeur_id">
                            <div class="col-md-6">
                                <strong>Éditeur :</strong>
                                <a t-attf-href="/shop/editeurs/{{ comic_edition.work_id.serie_id.editeur_id.id }}"
                                   t-esc="comic_edition.work_id.serie_id.editeur_id.name"/>
                            </div>
                        </t>
                    </div>

                    <!-- Auteurs avec rôles -->
                    <t t-if="comic_edition.work_id.auteur_line_ids">
                        <div class="mt-3">
                            <strong>Auteurs :</strong>
                            <ul class="list-unstyled ms-2 mb-0">
                                <t t-foreach="comic_edition.work_id.auteur_line_ids" t-as="line">
                                    <li>
                                        <a t-attf-href="/shop/auteurs/{{ line.partner_id.id }}"
                                           t-esc="line.partner_id.name"/>
                                        <span class="text-muted ms-1">
                                            (<t t-esc="dict(scenariste='Scénariste', dessinateur='Dessinateur', coloriste='Coloriste', encreur='Encreur', traducteur='Traducteur', autre='Autre').get(line.role, line.role)"/>)
                                        </span>
                                    </li>
                                </t>
                            </ul>
                        </div>
                    </t>

                    <!-- Synopsis -->
                    <t t-if="comic_edition.synopsis">
                        <div class="mt-3">
                            <strong>Synopsis :</strong>
                            <div class="mt-1" t-out="comic_edition.synopsis"/>
                        </div>
                    </t>
                </section>
            </t>
        </xpath>

        <!-- Carrousel "Les autres tomes de la série" sous la fiche produit -->
        <xpath expr="//section[@id='product_detail']" position="after">
            <t t-if="comic_edition and comic_other_tomes">
                <section class="o_comic_other_tomes container mt-4 mb-5">
                    <h4 class="mb-3">
                        Les autres tomes de
                        <em t-esc="comic_edition.work_id.serie_id.name"/>
                    </h4>
                    <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-3">
                        <t t-foreach="comic_other_tomes" t-as="other">
                            <div class="col">
                                <a t-att-href="other.product_tmpl_id.website_url or '/shop'"
                                   class="text-decoration-none">
                                    <div class="card h-100 shadow-sm">
                                        <t t-if="other.product_tmpl_id.image_512">
                                            <img t-att-src="'/web/image/product.template/%d/image_512' % other.product_tmpl_id.id"
                                                 class="card-img-top"
                                                 t-att-alt="other.work_id.titre_canonique"
                                                 loading="lazy"/>
                                        </t>
                                        <div class="card-body p-2 text-center">
                                            <small class="fw-bold">T<t t-esc="other.work_id.tome"/></small><br/>
                                            <small class="text-muted" t-esc="other.work_id.titre_canonique"/>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </t>
                    </div>
                </section>
            </t>
        </xpath>

    </template>

</odoo>
