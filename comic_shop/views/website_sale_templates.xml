<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Héritage de la page produit website_sale pour les albums BD.
        Toute injection est conditionnelle à l'existence de comic_album
        (fourni par ComicShopController.product()), donc sans impact
        sur les produits non-BD.

        ⚠️ XPaths à vérifier sur l'instance Odoo 19 réelle si le layout
        website_sale a évolué. Les templates ciblent des éléments stables
        (h1, js_product) mais peuvent nécessiter un ajustement.
    -->

    <template id="product_bd_enrich" inherit_id="website_sale.product" name="BD — Enrichissement page produit">

        <!-- 1. Badge "Tome X de la série Y" + badge "Dans votre bibliothèque" sous le h1 -->
        <xpath expr="//h1" position="after">
            <t t-if="comic_album">
                <div class="mb-2 d-flex flex-wrap gap-2">
                    <!-- Badge série/tome -->
                    <t t-if="comic_album.serie_id and comic_album.tome">
                        <span class="badge bg-primary fs-6">
                            Tome <t t-esc="comic_album.tome"/> —
                            <t t-esc="comic_album.serie_id.name"/>
                        </span>
                    </t>
                    <!-- Badge bibliothèque -->
                    <t t-if="comic_in_library">
                        <span class="badge bg-success fs-6">
                            <i class="fa fa-book me-1"/>Dans votre bibliothèque
                        </span>
                    </t>
                </div>
            </t>
        </xpath>

        <!-- 2. Fiche BD détaillée — après le bloc principal js_product -->
        <xpath expr="//div[hasclass('js_product')]" position="after">
            <t t-if="comic_album">
                <section class="o_comic_bd_details container mt-4 mb-4">
                    <div class="row">
                        <div class="col-12">
                            <h4 class="mb-3">Informations sur l'album</h4>
                            <div class="row g-2">
                                <t t-if="comic_album.serie_id">
                                    <div class="col-md-4">
                                        <strong>Série :</strong>
                                        <span t-esc="comic_album.serie_id.name"/>
                                    </div>
                                </t>
                                <t t-if="comic_album.tome">
                                    <div class="col-md-4">
                                        <strong>Tome :</strong>
                                        <span t-esc="comic_album.tome"/>
                                    </div>
                                </t>
                                <t t-if="comic_album.isbn">
                                    <div class="col-md-4">
                                        <strong>ISBN :</strong>
                                        <span t-esc="comic_album.isbn"/>
                                    </div>
                                </t>
                                <t t-if="comic_album.date_parution">
                                    <div class="col-md-4">
                                        <strong>Parution :</strong>
                                        <span t-esc="comic_album.date_parution"/>
                                    </div>
                                </t>
                                <t t-if="comic_album.nb_pages">
                                    <div class="col-md-4">
                                        <strong>Pages :</strong>
                                        <span t-esc="comic_album.nb_pages"/>
                                    </div>
                                </t>
                                <t t-if="comic_album.editeur_id">
                                    <div class="col-md-4">
                                        <strong>Éditeur :</strong>
                                        <span t-esc="comic_album.editeur_id.name"/>
                                    </div>
                                </t>
                            </div>

                            <!-- Auteurs avec rôles -->
                            <t t-if="comic_album.auteur_line_ids">
                                <div class="mt-3">
                                    <strong>Auteurs :</strong>
                                    <ul class="list-unstyled ms-2 mb-0">
                                        <t t-foreach="comic_album.auteur_line_ids" t-as="line">
                                            <li>
                                                <span t-esc="line.partner_id.name"/>
                                                <span class="text-muted ms-1">
                                                    (<span t-esc="line.role"/>)
                                                </span>
                                            </li>
                                        </t>
                                    </ul>
                                </div>
                            </t>

                            <!-- Synopsis -->
                            <t t-if="comic_album.synopsis">
                                <div class="mt-3">
                                    <strong>Synopsis :</strong>
                                    <div class="mt-1" t-out="comic_album.synopsis"/>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>
            </t>
        </xpath>

        <!-- 3. Carrousel "Les autres tomes de la série" en bas de page -->
        <xpath expr="//div[@id='wrap']" position="inside">
            <t t-if="comic_album and comic_other_tomes">
                <section class="o_comic_other_tomes container mt-4 mb-5">
                    <h4 class="mb-3">
                        Les autres tomes de
                        <em t-esc="comic_album.serie_id.name"/>
                    </h4>
                    <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-3">
                        <t t-foreach="comic_other_tomes" t-as="other">
                            <div class="col">
                                <a t-att-href="'/web#model=product.template&amp;id=%d' % other.product_tmpl_id.id"
                                   class="text-decoration-none">
                                    <div class="card h-100 shadow-sm">
                                        <t t-if="other.image_couverture">
                                            <img t-att-src="'/web/image/comic.album/%d/image_couverture/200x270' % other.id"
                                                 class="card-img-top"
                                                 t-att-alt="other.name"
                                                 loading="lazy"/>
                                        </t>
                                        <div class="card-body p-2 text-center">
                                            <small class="fw-bold">T<t t-esc="other.tome"/></small><br/>
                                            <small class="text-muted" t-esc="other.name"/>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </t>
                    </div>
                </section>
            </t>
        </xpath>

    </template>

</odoo>
