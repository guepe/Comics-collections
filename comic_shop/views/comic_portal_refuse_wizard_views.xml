<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_comic_portal_refuse_wizard_form" model="ir.ui.view">
        <field name="name">comic.portal.refuse.wizard.form</field>
        <field name="model">comic.portal.refuse.wizard</field>
        <field name="arch" type="xml">
            <form string="Refuser l'album proposé">
                <group>
                    <field name="work_id"/>
                    <field name="portal_partner_id"/>
                    <field name="motif" widget="radio"/>
                    <field name="target_work_id"
                           invisible="motif != 'doublon'"
                           required="motif == 'doublon'"
                           options="{'no_create': True}"/>
                    <field name="message" placeholder="Message facultatif pour le client…"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="motif != 'doublon'">
                    L'entrée de bibliothèque du client est reportée sur l'album existant,
                    puis l'album proposé est supprimé.
                </div>
                <div class="alert alert-warning" role="alert" invisible="motif != 'incorrect'">
                    L'album proposé, son édition, son ISBN et l'entrée de bibliothèque du client
                    sont supprimés. La série / l'éditeur créés par le client sont supprimés
                    s'ils ne servent plus.
                </div>
                <footer>
                    <button name="action_refuse" type="object" string="Refuser" class="btn-danger"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_comic_portal_refuse_wizard" model="ir.actions.act_window">
        <field name="name">Refuser l'album proposé</field>
        <field name="res_model">comic.portal.refuse.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
