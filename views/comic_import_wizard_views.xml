<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_comic_import_wizard_form" model="ir.ui.view">
        <field name="name">comic.import.wizard.form</field>
        <field name="model">comic.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import CSV/Excel">
                <sheet>
                    <field name="state" invisible="1"/>
                    <field name="template_file" invisible="1"/>
                    <field name="template_filename" invisible="1"/>
                    <field name="error_report_file" invisible="1"/>
                    <field name="error_report_filename" invisible="1"/>
                    <separator string="Modèle d'import"/>
                    <group invisible="state != 'draft'">
                        <field name="template_format" widget="radio"/>
                        <button name="action_download_template"
                                type="object"
                                string="Télécharger le modèle"
                                class="btn-secondary"/>
                    </group>
                    <separator string="Fichier à importer" invisible="state != 'draft'"/>
                    <group invisible="state != 'draft'">
                        <field name="import_file"
                               filename="import_filename"
                               required="state == 'draft'"/>
                        <field name="import_filename" invisible="1"/>
                        <field name="import_policy"/>
                    </group>
                    <separator string="Mapping des colonnes" invisible="state != 'mapping'"/>
                    <field name="mapping_line_ids" invisible="state != 'mapping'">
                        <list editable="bottom" create="false" delete="false">
                            <field name="sequence" widget="handle"/>
                            <field name="column_name"/>
                            <field name="sample_value"/>
                            <field name="target_field"/>
                        </list>
                    </field>
                    <group invisible="state != 'preview'">
                        <field name="preview_html"/>
                    </group>
                    <group invisible="state != 'done'">
                        <field name="result_html"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_prepare_mapping"
                            type="object"
                            string="Continuer"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_preview_import"
                            type="object"
                            string="Prévisualiser"
                            class="btn-primary"
                            invisible="state != 'mapping'"/>
                    <button name="action_import"
                            type="object"
                            string="Importer"
                            class="btn-primary"
                            invisible="state != 'preview'"/>
                    <button name="action_back_to_mapping"
                            type="object"
                            string="Retour au mapping"
                            class="btn-secondary"
                            invisible="state != 'preview'"/>
                    <button name="action_download_error_report"
                            type="object"
                            string="Télécharger les erreurs"
                            class="btn-secondary"
                            invisible="not error_report_file"/>
                    <button name="action_reset"
                            type="object"
                            string="Modifier"
                            class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button string="Fermer" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_comic_import_wizard" model="ir.actions.act_window">
        <field name="name">Import CSV/Excel</field>
        <field name="res_model">comic.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
