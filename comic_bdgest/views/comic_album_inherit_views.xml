<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bouton "BDGest" à côté du champ ISBN dans le formulaire album -->
    <record id="view_comic_album_form_bdgest" model="ir.ui.view">
        <field name="name">comic.album.form.bdgest</field>
        <field name="model">comic.album</field>
        <field name="inherit_id" ref="comics_collections.view_comic_album_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='isbn']" position="after">
                <button name="action_enrich_from_bdgest" type="object"
                        string="Enrichir depuis BDGest"
                        icon="fa-download"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>

    <!-- Action serveur : enrichissement batch depuis la vue liste -->
    <record id="action_server_bdgest_batch_enrich" model="ir.actions.server">
        <field name="name">Enrichir depuis BDGest</field>
        <field name="model_id" ref="comics_collections.model_comic_album"/>
        <field name="binding_model_id" ref="comics_collections.model_comic_album"/>
        <field name="binding_type">action</field>
        <field name="group_ids" eval="[Command.link(ref('comics_collections.group_comic_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_batch_enrich_from_bdgest()</field>
    </record>

</odoo>
