<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bouton "Enrichir depuis BDGest" dans le formulaire édition -->
    <record id="view_comic_edition_form_bdgest" model="ir.ui.view">
        <field name="name">comic.edition.form.bdgest</field>
        <field name="model">comic.edition</field>
        <field name="inherit_id" ref="comics_collections.view_comic_edition_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_enrich_from_bdgest" type="object"
                            string="Enrichir depuis BDGest"
                            class="btn-secondary"
                            groups="comics_collections.group_comic_manager"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- Action serveur : enrichissement batch depuis la vue liste -->
    <record id="action_server_bdgest_batch_enrich" model="ir.actions.server">
        <field name="name">Enrichir depuis BDGest</field>
        <field name="model_id" ref="comics_collections.model_comic_edition"/>
        <field name="binding_model_id" ref="comics_collections.model_comic_edition"/>
        <field name="binding_type">action</field>
        <field name="group_ids" eval="[Command.link(ref('comics_collections.group_comic_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_batch_enrich_from_bdgest()</field>
    </record>

</odoo>
