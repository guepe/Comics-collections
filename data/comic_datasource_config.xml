<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Valeurs par défaut des paramètres de configuration -->
    <record id="param_bdgest_enabled" model="ir.config_parameter">
        <field name="key">comic.bdgest_enabled</field>
        <field name="value">False</field>
    </record>
    <record id="param_bdgest_delay" model="ir.config_parameter">
        <field name="key">comic.bdgest_delay</field>
        <field name="value">2</field>
    </record>
    <record id="param_datasource_order" model="ir.config_parameter">
        <field name="key">comic.datasource_order</field>
        <field name="value">["google", "openlibrary", "bnf", "bdgest"]</field>
    </record>
</odoo>
